<?xml version="1.0" encoding="utf-8"?>
<!-- Main shell: navigation, page host, shared runtime console and status footer. -->
<Window
    x:Class="DshController.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshController"
    mc:Ignorable="d"
    Title="DSH Harness 控制器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== app title bar ==================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="54" Padding="22,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource BrandSoftBrush}">
                    <Image x:Name="TitleBarLogo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Source>
                            <SvgImageSource x:Name="TitleBarLogoSource" UriSource="ms-appx:///Assets/whale.svg"
                                            RasterizePixelWidth="40" RasterizePixelHeight="40" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="DSH HARNESS" Style="{StaticResource Wordmark}" />
                    <TextBlock Text="运行时控制台" Style="{StaticResource FooterText}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="BtnTheme" Style="{StaticResource BtnIcon}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,150,0" Click="BtnTheme_Click"
                    ToolTipService.ToolTip="切换主题：跟随系统 / 浅色 / 深色">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="14" />
                    <TextBlock Text="主题" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== navigation + page host ==================== -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        OpenPaneLength="232"
                        Background="Transparent"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource BrandSoftColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandSoftColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource BrandPrimaryColor}" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel Margin="18,18,18,10" Spacing="4">
                    <TextBlock Text="工作台" Style="{StaticResource PageEyebrow}" />
                    <TextBlock Text="管理本地运行时" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavWin" Content="Windows 实例" Tag="win"
                                    ToolTipService.ToolTip="管理本机 Windows 环境运行的 harness 实例">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavWsl" Content="WSL 实例" Tag="wsl"
                                    ToolTipService.ToolTip="管理 WSL2 发行版内运行的 harness 实例">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavMarket" Content="插件市场" Tag="market"
                                    ToolTipService.ToolTip="搜索社区插件并安装到指定实例">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE719;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavPlugins" Content="插件管理" Tag="plugins"
                                    ToolTipService.ToolTip="查看、升级或卸载实例插件">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavSettings" Content="应用设置" Tag="settings"
                                    ToolTipService.ToolTip="配置报告目录、实例目录、工作区和市场源">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Style="{StaticResource DshSidebarCard}" Margin="14,12,14,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="运行状态" Style="{StaticResource NavCaption}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{ThemeResource StateRunBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="控制台已就绪" FontSize="12" Foreground="{ThemeResource LabelPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="日志会在后台持续记录" Style="{StaticResource FooterText}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <Grid x:Name="ContentRoot" Background="{ThemeResource BgBaseBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- page layer: controls stay alive while navigation changes visibility -->
                    <local:InstancePanel x:Name="PanelWin" Grid.Row="0" />
                    <local:InstancePanel x:Name="PanelWsl" Grid.Row="0" Visibility="Collapsed" />
                    <local:PluginMarketPanel x:Name="PanelMarket" Grid.Row="0" Visibility="Collapsed" />
                    <local:PluginManagePanel x:Name="PanelPlugins" Grid.Row="0" Visibility="Collapsed" />

                    <!-- ==================== global settings ==================== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="34,28,34,30" Spacing="18">
                            <StackPanel Spacing="5">
                                <TextBlock Text="应用设置" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="配置所有实例共用的目录、工作区与插件市场连接。" Style="{StaticResource PageSubtitle}" />
                            </StackPanel>

                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="路径与来源" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="这些设置会影响新建实例、诊断报告和插件目录。" Style="{StaticResource HelperText}" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="错误报告目录" Style="{StaticResource FieldLabel}"
                                                   ToolTipService.ToolTip="后端启动失败时生成 Markdown 报告的目录" />
                                        <TextBox Grid.Column="1" x:Name="TxtReportDir" Style="{StaticResource InputBox}"
                                                 PlaceholderText="留空 = 我的文档\DshController\error-reports" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseRd" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseRd_Click" />
                                        <Button Grid.Column="3" x:Name="BtnOpenRd" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenReportDir_Click" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="实例目录根" Style="{StaticResource FieldLabel}"
                                                   ToolTipService.ToolTip="新建或克隆 Windows 实例时 DSH_HOME 的父目录" />
                                        <TextBox Grid.Column="1" x:Name="TxtHomeRoot" Style="{StaticResource InputBox}" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseRoot" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseRoot_Click" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Windows 默认工作区" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" x:Name="TxtNewWsWin" Style="{StaticResource InputBox}"
                                                 PlaceholderText="留空 = 继承当前选中实例的工作目录" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseNewWsWin" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseNewWs_Click" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="WSL 默认工作区" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" x:Name="TxtNewWsWsl" Style="{StaticResource InputBox}"
                                                 PlaceholderText="留空 = ~/dsh-workspaces 或继承当前选中实例" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="目录刷新间隔" Style="{StaticResource FieldLabel}"
                                                   ToolTipService.ToolTip="插件市场目录自动刷新的时间间隔" />
                                        <TextBox Grid.Column="1" x:Name="TxtCatalogRefresh" Style="{StaticResource InputBox}" Text="24" />
                                        <TextBlock Grid.Column="2" Text="小时（0 = 每次打开都刷新）" Style="{StaticResource HelperText}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="dshCommand" Style="{StaticResource FieldLabel}"
                                                   ToolTipService.ToolTip="Windows 环境 dsh 命令覆盖；留空自动查找" />
                                        <TextBox Grid.Column="1" x:Name="TxtDshCommand" Style="{StaticResource InputBox}" PlaceholderText="留空自动查找" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="自定义市场源" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" x:Name="TxtRegistry" Style="{StaticResource InputBox}" PlaceholderText="留空 = 不使用自定义源" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DshInfoCard}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="15"
                                              Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource HelperText}"
                                               Text="报告目录与 dshCommand 修改后立即生效；其余设置会在下次新建、克隆实例或启动后端时生效。" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button x:Name="BtnCancelGlobal" Style="{StaticResource BtnSecondary}" Click="BtnCancelGlobal_Click" Content="取消" />
                                <Button x:Name="BtnSaveGlobal" Style="{StaticResource BtnPrimary}" Click="BtnSaveGlobal_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock Text="保存设置" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== shared runtime console ==================== -->
                    <Grid x:Name="ConsoleDock" Grid.Row="1" Background="{ThemeResource BgBaseBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DshConsoleHeader}" Margin="18,0,18,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Width="7" Height="7" CornerRadius="4" Background="{ThemeResource StateRunBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource ConsoleTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="实时" FontSize="11" Foreground="{ThemeResource ConsoleMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                    <Button x:Name="BtnAutoScroll" Style="{StaticResource BtnConsole}" Content="自动滚动：开" Click="BtnAutoScroll_Click" />
                                    <Button x:Name="BtnCopyLog" Style="{StaticResource BtnConsole}" Content="复制" Click="BtnCopyLog_Click" />
                                    <Button x:Name="BtnClearLog" Style="{StaticResource BtnConsole}" Content="清空" Click="BtnClearLog_Click" />
                                    <Button x:Name="BtnOpenReportDir" Style="{StaticResource BtnConsole}" Content="报告目录" Click="BtnOpenReportDir_Click" />
                                </StackPanel>
                                <Button Grid.Column="3" x:Name="BtnConsoleToggle" Style="{StaticResource BtnConsoleToggle}" Margin="8,0,0,0"
                                        Click="BtnConsoleToggle_Click" ToolTipService.ToolTip="收起或展开运行日志">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="IconConsoleToggle" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="11" />
                                        <TextBlock x:Name="TxtConsoleToggle" Text="展开" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" x:Name="ConsoleFrame" Style="{StaticResource DshConsoleFrame}" Margin="18,0,18,12">
                            <TextBox x:Name="TxtLog" Style="{StaticResource LogBox}" Visibility="Collapsed">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource ConsoleTextColor}" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource ConsoleTextColor}" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource ConsoleTextColor}" />
                                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource ConsoleMutedColor}" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource BgCodeColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource BgCodeColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource BgCodeColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource BgCodeColor}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- ==================== status footer ==================== -->
        <Border Grid.Row="2" Background="{ThemeResource ShellBrush}"
                BorderBrush="{ThemeResource BorderBrushToken}" BorderThickness="0,1,0,0"
                Padding="22,9,22,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText" Style="{StaticResource FooterText}" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Text="DSH Controller" Style="{StaticResource FooterText}" Opacity="0.72" />
            </Grid>
        </Border>
    </Grid>
</Window>
