<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  MainWindow — 主窗口（v0.5.0 双界面布局）

  Windows 实例与 WSL 实例分别在两个独立标签页中管理（各挂一个
  InstancePanel，实例列表/状态/操作/设置互不混用）。
  下方为共享的：全局设置、控制台（后端日志）、页脚。
  ============================================================================ -->
<Window
    x:Class="DshController.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshController"
    mc:Ignorable="d"
    Title="DSH Harness 控制器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏（拖拽区） ==================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image x:Name="TitleBarLogo" Width="20" Height="20">
                    <Image.Source>
                        <SvgImageSource x:Name="TitleBarLogoSource" UriSource="ms-appx:///Assets/whale.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" />
                    </Image.Source>
                </Image>
                <TextBlock Text="DSH HARNESS 控制器" Style="{StaticResource Wordmark}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 主题切换：留出右侧系统标题按钮空间 -->
            <Button x:Name="BtnTheme" Style="{StaticResource BtnIcon}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,150,0" Click="BtnTheme_Click"
                    ToolTipService.ToolTip="切换主题：跟随系统 / 浅色 / 深色">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="14" />
            </Button>
        </Grid>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- v0.5.0：Windows / WSL 实例各占一个独立标签页 -->
            <!-- 注意：TabView 无 CanCloseTabs 属性（关闭按钮由 TabViewItem.IsClosable 控制）；
                 写错的属性会让 WASDK 1.5 的 XamlCompiler 静默崩溃（exit 1，无诊断） -->
            <TabView x:Name="Tabs" Grid.Row="0" Background="Transparent"
                     IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
                <TabView.TabItems>
                    <TabViewItem x:Name="TabWin" Header="Windows 实例" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" />
                        </TabViewItem.IconSource>
                        <local:InstancePanel x:Name="PanelWin" />
                    </TabViewItem>
                    <TabViewItem x:Name="TabWsl" Header="WSL 实例" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" />
                        </TabViewItem.IconSource>
                        <local:InstancePanel x:Name="PanelWsl" />
                    </TabViewItem>
                </TabView.TabItems>
            </TabView>

            <!-- ==================== 全局设置 ==================== -->
            <Expander x:Name="ExpGlobalSettings" Grid.Row="1" Header="全局设置"
                      Margin="16,4,16,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="全局设置" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Spacing="12" Margin="4,10,4,4" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="报告目录" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                   ToolTipService.ToolTip="后端启动失败时，报错信息 + 实例信息 + 时间 生成 Markdown 报告保存到此目录" />
                        <TextBox Grid.Column="1" x:Name="TxtReportDir" Style="{StaticResource InputBox}"
                                 PlaceholderText="留空 = 我的文档\DshController\error-reports" />
                        <Button Grid.Column="2" x:Name="BtnBrowseRd" Style="{StaticResource BtnCompact}" Content="浏览…" Click="BtnBrowseRd_Click" />
                        <Button Grid.Column="3" x:Name="BtnOpenRd" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenReportDir_Click"
                                ToolTipService.ToolTip="在资源管理器中打开该目录（不存在会自动创建）" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="实例目录根" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                   ToolTipService.ToolTip="新建/克隆 Windows 实例时 DSH_HOME 的父目录" />
                        <TextBox Grid.Column="1" x:Name="TxtHomeRoot" Style="{StaticResource InputBox}" />
                        <Button Grid.Column="2" x:Name="BtnBrowseRoot" Style="{StaticResource BtnCompact}" Content="浏览…" Click="BtnBrowseRoot_Click" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="新实例默认工作区" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                   ToolTipService.ToolTip="新建/克隆实例对话框中工作目录的默认值；留空则回退为当前选中实例的工作目录" />
                        <TextBox Grid.Column="1" x:Name="TxtNewWs" Style="{StaticResource InputBox}"
                                 PlaceholderText="留空 = 继承当前选中实例的工作目录" />
                        <Button Grid.Column="2" x:Name="BtnBrowseNewWs" Style="{StaticResource BtnCompact}" Content="浏览…" Click="BtnBrowseNewWs_Click" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="dshCommand" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                   ToolTipService.ToolTip="Windows 环境 dsh 命令覆盖；留空自动查找（npm shim / PATH / node 入口）" />
                        <TextBox Grid.Column="1" x:Name="TxtDshCommand" Style="{StaticResource InputBox}"
                                 PlaceholderText="留空自动查找" />
                    </Grid>

                    <Grid ColumnSpacing="10" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnCancelGlobal" Style="{StaticResource BtnSecondary}" Click="BtnCancelGlobal_Click"
                                ToolTipService.ToolTip="放弃更改并收起">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8bb;" FontSize="12" />
                                <TextBlock Text="取消" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="BtnSaveGlobal" Style="{StaticResource BtnPrimary}" Click="BtnSaveGlobal_Click"
                                ToolTipService.ToolTip="保存全局设置并收起">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73e;" FontSize="12" />
                                <TextBlock Text="保存" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ==================== 控制台（后端日志） ==================== -->
            <Grid Grid.Row="2" Margin="16,8,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D4;" FontSize="13"
                              Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="控制台" FontWeight="SemiBold" FontSize="13"
                               Foreground="{ThemeResource LabelPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnAutoScroll" Style="{StaticResource BtnCompact}" Content="滚动：开" Click="BtnAutoScroll_Click" />
                    <Button x:Name="BtnCopyLog" Style="{StaticResource BtnCompact}" Content="复制日志" Click="BtnCopyLog_Click"
                            ToolTipService.ToolTip="把控制台全部日志复制到剪贴板" />
                    <Button x:Name="BtnClearLog" Style="{StaticResource BtnCompact}" Content="清空" Click="BtnClearLog_Click" />
                    <Button x:Name="BtnOpenReportDir" Style="{StaticResource BtnCompact}" Content="打开报告目录" Click="BtnOpenReportDir_Click"
                            ToolTipService.ToolTip="在资源管理器中打开错误报告保存目录" />
                </StackPanel>
            </Grid>
            <TextBox Grid.Row="3" x:Name="TxtLog" Style="{StaticResource LogBox}" Height="200" Margin="16,4,16,0" />

            <!-- 页脚 -->
            <TextBlock Grid.Row="4" x:Name="FooterText" Style="{StaticResource FooterText}"
                       Margin="16,8,16,10" TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</Window>
