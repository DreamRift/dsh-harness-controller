<?xml version="1.0" encoding="utf-8"?>
<!-- Instance workspace. The order follows the task flow: choose → inspect → act → configure. -->
<UserControl
    x:Class="DshController.InstancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="34,28,34,30" Spacing="18">

                <!-- ==================== page heading ==================== -->
                <StackPanel Spacing="5">
                    <TextBlock x:Name="TxtPageEyebrow" Text="RUNTIME WORKSPACE" Style="{StaticResource PageEyebrow}" />
                    <TextBlock x:Name="TxtPageTitle" Text="Windows 实例" Style="{StaticResource PageTitle}" />
                </StackPanel>

                <!-- 去版本化轮：旧工具条（当前实例下拉/新建/扫描）已移除——新建与扫描入口上移左栏，克隆/删除迁入下方状态卡头部 -->
                <TextBlock x:Name="TxtInstanceHint" Style="{StaticResource HelperText}" Margin="2,0,2,0" />

                <!-- ==================== failure recovery ==================== -->
                <InfoBar x:Name="FailBar" IsOpen="False" Severity="Error" IsClosable="True"
                         Title="后端启动失败" Message="">
                    <InfoBar.ActionButton>
                        <Button x:Name="BtnOpenReport" Content="打开报告" Click="BtnOpenReport_Click" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,10">
                            <Button x:Name="BtnOpenReportDir" Style="{StaticResource BtnCompact}" Content="报告目录" Click="BtnOpenReportDir_Click" />
                            <Button x:Name="BtnCopyReportPath" Style="{StaticResource BtnCompact}" Content="复制路径" Click="BtnCopyReportPath_Click" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- ==================== status hero ==================== -->
                <Border Style="{StaticResource DshHeroCard}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5"
                                            VerticalAlignment="Center" Background="{ThemeResource StateStopBrush}" />
                                    <TextBlock x:Name="StatusText" Text="已停止" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{ThemeResource LabelPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border x:Name="EnvBadge" CornerRadius="8" Padding="9,4" VerticalAlignment="Center"
                                            Background="{ThemeResource BrandSoftBrush}">
                                        <TextBlock x:Name="EnvBadgeText" Text="WINDOWS" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource BrandPrimaryBrush}" CharacterSpacing="70" />
                                    </Border>
                                </StackPanel>
                                <!-- 克隆/删除自旧工具条迁入（去版本化轮）：与状态/环境徽标同排右对齐，名称与 Click 处理器不变 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="BtnClone" Style="{StaticResource BtnCompact}" Click="BtnClone_Click"
                                            ToolTipService.ToolTip="克隆本环境的现有实例或默认主目录">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="12" />
                                            <TextBlock Text="克隆" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnDelete" Style="{StaticResource BtnCompact}" Click="BtnDelete_Click"
                                            ToolTipService.ToolTip="停止该实例并删除注册项与数据目录">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="删除" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="13"
                                          Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="UrlLink" Padding="0" Margin="0" FontSize="14"
                                                 Content="http://127.0.0.1:3080/" NavigateUri="http://127.0.0.1:3080/"
                                                 ToolTipService.ToolTip="在浏览器中打开该实例界面">
                                    <HyperlinkButton.Resources>
                                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource BrandPrimaryColor}" />
                                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource BrandPrimaryHoverColor}" />
                                    </HyperlinkButton.Resources>
                                </HyperlinkButton>
                                <Button x:Name="BtnCopyUrl" Style="{StaticResource BtnCompact}" Content="复制地址"
                                        Click="BtnCopyUrl_Click" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtAnnounced" Style="{StaticResource HelperText}" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock x:Name="HomeText" Text="DSH_HOME: ~/.dsh（默认，不注入）" Style="{StaticResource HelperText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="进程 PID" Style="{StaticResource FooterText}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="PidText" Text="—" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="22"
                                       Foreground="{ThemeResource LabelPrimaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== primary actions ==================== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStart" Style="{StaticResource BtnPrimary}" Click="BtnStart_Click"
                            ToolTipService.ToolTip="启动该实例后端">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="启动后端" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BtnRestart" Style="{StaticResource BtnSecondary}" Click="BtnRestart_Click"
                            ToolTipService.ToolTip="仅重启 harness 后端，不会打开新的浏览器界面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="15" />
                            <TextBlock Text="重启" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnStop" Style="{StaticResource BtnDangerGhost}" Click="BtnStop_Click"
                            ToolTipService.ToolTip="结束 dsh web 进程树">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="15" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="BtnOpen" Style="{StaticResource BtnSecondary}" Click="BtnOpen_Click"
                            ToolTipService.ToolTip="在默认浏览器打开该实例界面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="15" />
                            <TextBlock Text="打开界面" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== configuration ==================== -->
                <Expander x:Name="ExpInstanceSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="实例设置" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtSettingsSubtitle" Style="{StaticResource FooterText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>

                        <!-- 分节卡片（与应用设置页同一排版语法：230 标题+说明列｜编辑器列）；控件名与读写逻辑不变 -->
                        <StackPanel Spacing="14" Margin="0,12,0,0">
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="连接" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="主机" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="后端绑定的监听地址（通常 127.0.0.1）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<TextBox Grid.Column="1" x:Name="TxtHost" Style="{StaticResource InputBox}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="240" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="后端监听端口；「推荐端口」自动选空闲口" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBox x:Name="TxtPort" Style="{StaticResource InputBox}" Width="90" />
                                            <Button x:Name="BtnSuggestPort" Style="{StaticResource BtnCompact}" Content="推荐端口" Click="BtnSuggestPort_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="路径" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="工作目录" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="dsh web 进程的工作目录" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<TextBox Grid.Column="1" x:Name="TxtWorkspace" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseWs" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseWs_Click" />
                                        <Button Grid.Column="3" x:Name="BtnOpenWs" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenWs_Click" />
                                    </Grid>
                                    <TextBlock x:Name="TxtWorkspaceHint" Style="{StaticResource SettingHint}" Margin="230,-6,0,0" />
                                    <Grid x:Name="RowWinHome" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="DSH_HOME" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="实例独立 HOME；留空 = 默认 ~/.dsh（不注入）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<TextBox Grid.Column="1" x:Name="TxtHome" Style="{StaticResource InputBox}" VerticalAlignment="Center" PlaceholderText="留空 = 默认 ~/.dsh（不注入）" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseHome" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseHome_Click" />
                                        <Button Grid.Column="3" x:Name="BtnOpenHome" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenHome_Click" />
                                    </Grid>
                                    <Grid x:Name="RowWslDistro" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="WSL 发行版" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="在哪个 WSL2 发行版内运行后端" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<ComboBox Grid.Column="1" x:Name="CmbWslDistro" Style="{StaticResource InputCombo}" IsEditable="True" HorizontalAlignment="Left" Width="240" VerticalAlignment="Center" PlaceholderText="如 Ubuntu-24.04" />
                                        <Button Grid.Column="2" x:Name="BtnListDistros" Style="{StaticResource BtnCompact}" Content="扫描发行版" Click="BtnListDistros_Click" />
                                    </Grid>
                                    <Grid x:Name="RowWslHome" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="WSL DSH_HOME" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="发行版内的 HOME（Linux 路径）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<TextBox Grid.Column="1" x:Name="TxtWslHome" Style="{StaticResource InputBox}" VerticalAlignment="Center" PlaceholderText="留空 = ~/.dsh（如 ~/dsh-instances/main）" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- 升级卡：把选定 dsh 版本装进本实例的运行环境（Windows 全局 / 发行版内），重启实例生效 -->
                            <Border Style="{StaticResource DshCard}" Loaded="UpgradeCard_Loaded">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="升级" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource SettingHint}" TextWrapping="Wrap"
                                               Text="把选定版本安装到本实例的运行环境（Windows 全局 / 发行版内），安装后本实例跟随该版本，重启实例生效。不影响其它钉住版本的实例。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="dsh 版本" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="npm 上 @deepseek-ai/dsh 的已发布版本（新→旧，可手输）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ComboBox x:Name="CmbUpgradeVersion" Style="{StaticResource InputCombo}" IsEditable="True"
                                                      MinWidth="220" PlaceholderText="选择或输入版本号"
                                                      DropDownOpened="CmbUpgradeVersion_DropDownOpened" />
                                            <Button x:Name="BtnUpgradeInstance" Style="{StaticResource BtnCompact}" Content="升级"
                                                    Click="BtnUpgradeInstance_Click" AutomationProperties.AutomationId="BtnUpgradeInstance" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtUpgradeHint" Style="{StaticResource SettingHint}" Margin="230,-6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="行为" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="启动后自动打开浏览器" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="仅「启动」路径生效；重启绝不拉浏览器" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<ToggleSwitch Grid.Column="1" x:Name="SwAutoOpen" Header="" OnContent="" OffContent="" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="退出时停止本程序启动的后端" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="关闭窗口前自动结束其托管的 dsh 进程" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<ToggleSwitch Grid.Column="1" x:Name="SwStopOnExit" Header="" OnContent="" OffContent="" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="高级" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="trusted-hosts" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="允许访问 Web API 的额外主机（逗号分隔）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<TextBox Grid.Column="1" x:Name="TxtTrustedHosts" Style="{StaticResource InputBox}" VerticalAlignment="Center" PlaceholderText="例：192.168.1.10, localhost" />
                                    </Grid>
                                    <Grid x:Name="RowWslPolicy" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="停止后关闭" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="WSL 实例停止后是否终止发行版/VM" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
<ComboBox Grid.Column="1" x:Name="CmbWslPolicy" Style="{StaticResource InputCombo}" HorizontalAlignment="Left" Width="260" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button x:Name="BtnCancelInstance" Style="{StaticResource BtnSecondary}" Click="BtnCancelInstance_Click" Content="取消" />
                                <Button x:Name="BtnSaveInstance" Style="{StaticResource BtnPrimary}" Click="BtnSaveInstance_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock Text="保存实例" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                </Expander>

                <!-- ==================== empty state ==================== -->
                <Border x:Name="EmptyHint" Style="{StaticResource DshInfoCard}" Visibility="Collapsed">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmptyHintText" Text="本环境暂无实例，点击左栏「＋ 新建实例」开始"
                                       Style="{StaticResource HelperText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
