<?xml version="1.0" encoding="utf-8"?>
<!-- Community catalogue: choose a target, search the catalogue, install with confidence. -->
<UserControl
    x:Class="DshController.PluginMarketPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshController"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,28,34,18" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="EXTENSIONS" Style="{StaticResource PageEyebrow}" />
                <TextBlock Text="插件市场" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="TxtFreshness" Style="{StaticResource FooterText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                       ToolTipService.ToolTip="各来源加载状态与数据时间" />
            <Button Grid.Column="2" x:Name="BtnSources" Style="{StaticResource BtnCompact}" Click="BtnSources_Click"
                    ToolTipService.ToolTip="选择启用的目录来源">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" FontSize="12" />
                    <TextBlock x:Name="TxtSourcesLabel" Text="数据源" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" x:Name="BtnRefreshCatalog" Style="{StaticResource BtnCompact}" Click="BtnRefreshCatalog_Click"
                    ToolTipService.ToolTip="重新拉取全部启用来源的目录">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 两栏壳·宽度治理：TxtInstanceMeta 由行内第 5 列移入下缘小字行（960 档主区≈690 不再挤出窗口；控件与绑定不变） -->
        <Border Grid.Row="1" Style="{StaticResource DshToolbarCard}" Margin="34,0,34,10">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="安装到实例" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="CmbInstance" Style="{StaticResource InputCombo}" HorizontalAlignment="Stretch"
                              SelectionChanged="CmbInstance_Changed"
                              ToolTipService.ToolTip="Windows 与 WSL 实例都在此列表">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" ToolTipService.ToolTip="{Binding Converter={StaticResource DisplayTooltip}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="profile" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" x:Name="TxtProfile" Style="{StaticResource InputBox}" Text="web" />
                    <Button Grid.Column="4" x:Name="BtnOpenHome" Style="{StaticResource BtnCompact}" Click="BtnOpenHome_Click"
                            Content="打开 HOME" ToolTipService.ToolTip="打开所选实例的 DSH_HOME 目录" />
                </Grid>
                <TextBlock x:Name="TxtInstanceMeta" Style="{StaticResource FooterText}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Margin="2,0,2,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DshCardTight}" Margin="34,0,34,14">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtSearch" Style="{StaticResource InputBox}"
                         PlaceholderText="搜索名称、简介、包名或标签" TextChanged="TxtSearch_TextChanged" />
                <ComboBox Grid.Column="1" x:Name="CmbCategory" Style="{StaticResource InputCombo}" MinWidth="130"
                          SelectionChanged="Filter_SelectionChanged" ToolTipService.ToolTip="按分类过滤">
                    <ComboBoxItem Content="全部分类" IsSelected="True" Tag="" />
                </ComboBox>
                <ComboBox Grid.Column="2" x:Name="CmbSort" Style="{StaticResource InputCombo}" MinWidth="104"
                          SelectionChanged="Filter_SelectionChanged" ToolTipService.ToolTip="排序方式">
                    <ComboBoxItem Content="按热度" IsSelected="True" Tag="stars" />
                    <ComboBoxItem Content="最近更新" Tag="updated" />
                </ComboBox>
                <CheckBox Grid.Column="3" x:Name="ChkInstallable" Content="仅可安装" MinHeight="40"
                          Checked="Filter_Toggled" Unchecked="Filter_Toggled" />
                <CheckBox Grid.Column="4" x:Name="ChkVerified" Content="仅人工复核" MinHeight="40"
                          Checked="Filter_Toggled" Unchecked="Filter_Toggled" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="34,0,30,0">
            <ListView x:Name="ListPlugins" SelectionMode="None" Padding="0,0,6,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MarketItem">
                        <Border Style="{StaticResource DshCardTight}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource LabelPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind VerifiedVis}">
                                            <TextBlock Text="✓ 人工复核" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind UnverifiedVis}">
                                            <TextBlock Text="未审核" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind InstalledVis}">
                                            <TextBlock Text="已安装" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind MultiSourceVis}">
                                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind BrowseVis}">
                                            <TextBlock Text="仅浏览" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource FooterText}" />
                                    <TextBlock Text="{x:Bind DescText}" FontSize="13" Foreground="{ThemeResource LabelSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind PkgText}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind CompatText}" Style="{StaticResource HelperText}" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind CompatVis}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                    <Button Style="{StaticResource BtnPrimary}" Content="{x:Bind InstallLabel}"
                                            IsEnabled="{x:Bind InstallEnabled}" Click="BtnInstall_Click" Tag="{x:Bind}"
                                            Visibility="{x:Bind InstallVis}" ToolTipService.ToolTip="{x:Bind InstallTip}" />
                                    <Button Style="{StaticResource BtnCompact}" Content="详情" Click="BtnDetail_Click" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="查看简介、来源和安装命令" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="10" MaxWidth="460">
                <Border Width="52" Height="52" CornerRadius="16" Background="{ThemeResource BrandSoftBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE719;" FontSize="22"
                              Foreground="{ThemeResource BrandPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TxtEmpty" Text="" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource LabelSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="34,10,34,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" x:Name="BusyRing" Width="18" Height="18" IsActive="False" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="TxtStatus" Style="{StaticResource FooterText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
