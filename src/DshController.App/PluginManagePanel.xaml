<?xml version="1.0" encoding="utf-8"?>
<!-- Installed plugins: select a target, inspect the real profile, then act. -->
<UserControl
    x:Class="DshController.PluginManagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshController"
    xmlns:views="using:DshController.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="34,28,34,18" Spacing="5">
            <TextBlock Text="PLUGIN INVENTORY" Style="{StaticResource PageEyebrow}" />
            <TextBlock Text="插件管理" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DshToolbarCard}" Margin="34,0,34,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="目标实例" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="CmbInstance" Style="{StaticResource InputCombo}" HorizontalAlignment="Stretch"
                          SelectionChanged="CmbInstance_SelectionChanged"
                          ToolTipService.ToolTip="选择要查看的实例">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" ToolTipService.ToolTip="{Binding Converter={StaticResource DisplayTooltip}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="profile" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" x:Name="TxtProfile" Style="{StaticResource InputBox}" Text="web"
                         ToolTipService.ToolTip="插件生效的 profile（默认 web）" />
                <Button Grid.Column="4" x:Name="BtnRefresh" Style="{StaticResource BtnCompact}" Click="BtnRefresh_Click"
                        ToolTipService.ToolTip="重新读取实例 HOME 的已装状态">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DshInfoCard}" Margin="34,0,34,14">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" FontSize="16"
                          Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="TxtInstanceMeta" Style="{StaticResource HelperText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="34,0,30,0">
            <ListView x:Name="ListPlugins" SelectionMode="None" Padding="0,0,6,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ManageItem">
                        <Border Style="{StaticResource DshCardTight}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Pkg}" FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource LabelPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind VersionText}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource LabelSecondaryBrush}" />
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind BundleVis}">
                                            <TextBlock Text="bundle 生效" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind MarketVis}">
                                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind OtherSourceVis}">
                                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DepText}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="package.json 中的依赖声明" />
                                    <TextBlock Text="{x:Bind MarketMeta}" Style="{StaticResource HelperText}"
                                               Visibility="{x:Bind MarketVis}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- 升级钮（改版·升级详情弹窗）：仅"目录有来源+市场更高+未被忽略"探测命中后出现 -->
                                    <Button Style="{StaticResource BtnInline}" Content="升级" Tag="{x:Bind}"
                                            Visibility="{x:Bind HasUpgradeHint, Converter={StaticResource BoolToVis}}"
                                            Click="BtnUpgradeDetails_Click"
                                            ToolTipService.ToolTip="查看更新内容：升级 / 取消 / 忽略本次升级" />
                                    <Button Style="{StaticResource BtnDangerGhost}" Content="卸载"
                                            IsEnabled="{x:Bind CanUninstall}" Click="BtnUninstall_Click" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind UninstallTip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="10" MaxWidth="480">
                <Border Width="52" Height="52" CornerRadius="16" Background="{ThemeResource BrandSoftBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" FontSize="22"
                              Foreground="{ThemeResource BrandPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TxtEmpty" Text="" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource LabelSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="34,10,34,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" x:Name="BusyRing" Width="18" Height="18" IsActive="False" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="TxtStatus" Style="{StaticResource FooterText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
