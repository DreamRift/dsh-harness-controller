<!--
  DSH Controller Enhanced Design System

  增强的设计令牌和组件样式，在原有 DshTheme.xaml 基础上扩展
  参考 DeepSeek Harness 和 Anthropic Codex 的设计语言
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========================= 间距系统 ========================= -->
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">24</x:Double>
  <x:Double x:Key="Space2xl">32</x:Double>
  <x:Double x:Key="Space3xl">48</x:Double>

  <!-- ========================= 圆角系统 ========================= -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">16</CornerRadius>
  <CornerRadius x:Key="RadiusXl">20</CornerRadius>
  <CornerRadius x:Key="Radius2xl">24</CornerRadius>

  <!-- ========================= 增强的字体样式 ========================= -->

  <!-- 标题层次 -->
  <Style x:Key="HeadingXl" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="HeadingLg" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="HeadingMd" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="HeadingSm" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <!-- 正文文本 -->
  <Style x:Key="BodyLg" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="BodyMd" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
  </Style>

  <Style x:Key="BodySm" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
  </Style>

  <!-- ========================= 增强的卡片样式 ========================= -->

  <!-- 主卡片 - 增加阴影和内边距 -->
  <Style x:Key="CardPrimary" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <!-- 紧凑卡片 -->
  <Style x:Key="CardCompact" TargetType="Border" BasedOn="{StaticResource CardPrimary}">
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <!-- Hero 卡片 - 大间距，用于重要信息展示 -->
  <Style x:Key="CardHero" TargetType="Border" BasedOn="{StaticResource CardPrimary}">
    <Setter Property="Padding" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
  </Style>

  <!-- 浅色卡片 - 次要信息 -->
  <Style x:Key="CardSubtle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BgSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- 品牌卡片 - 突出显示 -->
  <Style x:Key="CardBrand" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- ========================= 增强的按钮样式 ========================= -->

  <!-- 主要按钮 - 品牌色，带阴影 -->
  <Style x:Key="BtnPrimaryEnhanced" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnBrandBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- 次要按钮 - 描边 -->
  <Style x:Key="BtnSecondaryEnhanced" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- Ghost 按钮 - 轻量级 -->
  <Style x:Key="BtnGhostEnhanced" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- 危险按钮 -->
  <Style x:Key="BtnDangerEnhanced" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource DangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- 图标按钮 -->
  <Style x:Key="BtnIconEnhanced" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>

  <!-- ========================= 增强的输入框样式 ========================= -->

  <Style x:Key="TextBoxEnhanced" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- ========================= 表格样式 ========================= -->

  <!-- 表格容器 -->
  <Style x:Key="TableContainer" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- 表头样式 -->
  <Style x:Key="TableHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LabelTertiaryBrush}" />
    <Setter Property="CharacterSpacing" Value="60" />
  </Style>

  <!-- 表格单元格 -->
  <Style x:Key="TableCell" TargetType="Border">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- ========================= 徽章样式 ========================= -->

  <!-- 主要徽章 -->
  <Style x:Key="BadgePrimary" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- 成功徽章 -->
  <Style x:Key="BadgeSuccess" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource StateRunSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- 警告徽章 -->
  <Style x:Key="BadgeWarning" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource StateStartingSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- 危险徽章 -->
  <Style x:Key="BadgeDanger" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DangerSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- ========================= 分隔线 ========================= -->

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,16" />
  </Style>

  <Style x:Key="DividerVertical" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="16,0" />
  </Style>

  <!-- ========================= 表单组件 ========================= -->

  <!-- 表单字段容器 -->
  <Style x:Key="FormField" TargetType="StackPanel">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>

  <!-- 表单标签 -->
  <Style x:Key="FormLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <!-- 表单提示文本 -->
  <Style x:Key="FormHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource LabelTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- 表单错误文本 -->
  <Style x:Key="FormError" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- ========================= 动画资源 ========================= -->

  <!-- 淡入动画 -->
  <Storyboard x:Key="FadeInStoryboard">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1" Duration="0:0:0.3">
      <DoubleAnimation.EasingFunction>
        <CubicEase EasingMode="EaseOut" />
      </DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- 淡出动画 -->
  <Storyboard x:Key="FadeOutStoryboard">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="1" To="0" Duration="0:0:0.2">
      <DoubleAnimation.EasingFunction>
        <CubicEase EasingMode="EaseIn" />
      </DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- 上滑淡入 -->
  <Storyboard x:Key="SlideUpFadeInStoryboard">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1" Duration="0:0:0.3">
      <DoubleAnimation.EasingFunction>
        <CubicEase EasingMode="EaseOut" />
      </DoubleAnimation.EasingFunction>
    </DoubleAnimation>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="20" To="0" Duration="0:0:0.3">
      <DoubleAnimation.EasingFunction>
        <CubicEase EasingMode="EaseOut" />
      </DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- ========================= 列表项样式 ========================= -->

  <Style x:Key="ListItem" TargetType="Border">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style x:Key="ListItemHoverable" TargetType="Border" BasedOn="{StaticResource ListItem}">
    <Setter Property="Background" Value="Transparent" />
    <!-- Hover 状态需要通过 VisualStateManager 实现 -->
  </Style>

</ResourceDictionary>
