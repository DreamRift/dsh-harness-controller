    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CharacterSpacing" Value="100" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="PageEyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Semibold" />
