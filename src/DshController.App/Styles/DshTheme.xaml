    <Setter Property="Template" Value="{StaticResource DshSecondaryButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="15,10" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style x:Key="BtnDangerGhost" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="Template" Value="{StaticResource DshDangerButtonTemplate}" />
    <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DangerBrush}" />
  </Style>

  <!-- 行内动作钮（升级/卸载/刷新这类）：统一 padding 与最小尺寸，禁止逐处硬编码 -->
  <Style x:Key="BtnInline" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style x:Key="BtnCompact" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- 顶栏页按钮（改版·顶栏四页）：常态=透明底+次级字色；选中态=品牌底+品牌字色+半粗。
       两态成对切换（代码换 Style），主题切换由 ThemeResource 自动跟随。 -->
  <Style x:Key="BtnPage" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="15,7" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style x:Key="BtnPageActive" TargetType="Button" BasedOn="{StaticResource BtnPage}">
    <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 左边栏竖排行（两栏页面壳）：占满栏宽、文字左对齐；成对切换同顶栏钮 -->
  <Style x:Key="BtnRail" TargetType="Button" BasedOn="{StaticResource BtnPage}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="BtnRailActive" TargetType="Button" BasedOn="{StaticResource BtnRail}">
    <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 顶栏右侧工具区钮（工具区与日志底栏）：图标+小字成组、幽灵底；成对切换同 BtnPage -->
  <Style x:Key="BtnTool" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style x:Key="BtnToolActive" TargetType="Button" BasedOn="{StaticResource BtnTool}">
    <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
  </Style>

  <Style x:Key="BtnIcon" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource DshIconButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="BtnConsole" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource DshConsoleButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource ConsoleMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="BtnConsoleToggle" TargetType="Button" BasedOn="{StaticResource BtnConsole}">
    <Setter Property="Foreground" Value="{ThemeResource ConsoleTextBrush}" />
    <Setter Property="Background" Value="{ThemeResource ConsoleControlBrush}" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <Style x:Key="InputBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="InputCombo" TargetType="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="LogBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{ThemeResource BgCodeBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BgCodeBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0,0,12,12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="Foreground" Value="{ThemeResource ConsoleTextBrush}" />
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <GridLength x:Key="SettingsLabelWidth">110</GridLength>
</ResourceDictionary>
