    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <!-- 设置项行形专用说明小字（标题+说明+编辑器 的“说明”位；实例/应用两设置区共用） -->
