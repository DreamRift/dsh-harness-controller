  <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource LabelPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource LabelPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource LabelPrimaryColor}" />
