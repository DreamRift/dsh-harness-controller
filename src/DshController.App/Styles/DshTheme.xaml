  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource BgCardColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource BgCardColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource BgSubtleColor}" />
