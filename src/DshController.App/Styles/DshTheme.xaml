<!--
  DSH Controller design system

  Direction: a quiet runtime workbench. The canvas stays neutral, the DSH blue
  is reserved for primary actions and selected navigation, while the terminal
  remains intentionally dark so operational output is easy to scan.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DshController.Views">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgBaseColor">#F4F6FA</Color>
      <Color x:Key="ShellColor">#F8FAFD</Color>
      <Color x:Key="BgCardColor">#FFFFFF</Color>
      <Color x:Key="BgSubtleColor">#F8FAFD</Color>
      <Color x:Key="BgCodeColor">#0D1726</Color>
      <Color x:Key="LabelPrimaryColor">#101828</Color>
      <Color x:Key="LabelSecondaryColor">#526071</Color>
      <Color x:Key="LabelTertiaryColor">#6B7788</Color>
      <Color x:Key="BorderColor">#1A101828</Color>
      <Color x:Key="BorderStrongColor">#2B101828</Color>
      <Color x:Key="BrandPrimaryColor">#3964FE</Color>
      <Color x:Key="BrandPrimaryHoverColor">#2F56E8</Color>
      <Color x:Key="BrandPrimaryPressedColor">#2445C4</Color>
      <Color x:Key="BrandSoftColor">#E9EEFF</Color>
      <Color x:Key="ControlHoverColor">#EEF2F7</Color>
      <Color x:Key="ControlPressedColor">#E2E8F0</Color>
      <Color x:Key="OnBrandColor">#FFFFFF</Color>
      <Color x:Key="StateRunColor">#138A63</Color>
      <Color x:Key="StateRunSoftColor">#DDF6EB</Color>
      <Color x:Key="StateStartingColor">#B86E00</Color>
      <Color x:Key="StateStartingSoftColor">#FFF0D3</Color>
      <Color x:Key="StateStopColor">#6B7788</Color>
      <Color x:Key="StateStopSoftColor">#EEF1F5</Color>
      <Color x:Key="DangerColor">#B42318</Color>
      <Color x:Key="DangerSoftColor">#FDE9E7</Color>
      <Color x:Key="ConsoleTextColor">#D7E2F0</Color>
      <Color x:Key="ConsoleMutedColor">#91A3B8</Color>
      <Color x:Key="ConsoleControlColor">#22344C</Color>
      <Color x:Key="ConsoleControlHoverColor">#2B4563</Color>
      <Color x:Key="ConsoleControlPressedColor">#365675</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgBaseColor">#101827</Color>
      <Color x:Key="ShellColor">#141E2E</Color>
      <Color x:Key="BgCardColor">#1A2638</Color>
      <Color x:Key="BgSubtleColor">#202D40</Color>
      <Color x:Key="BgCodeColor">#09111D</Color>
      <Color x:Key="LabelPrimaryColor">#F3F6FA</Color>
      <Color x:Key="LabelSecondaryColor">#A9B6C7</Color>
      <Color x:Key="LabelTertiaryColor">#8493A8</Color>
      <Color x:Key="BorderColor">#26FFFFFF</Color>
      <Color x:Key="BorderStrongColor">#3AFFFFFF</Color>
      <Color x:Key="BrandPrimaryColor">#6686FF</Color>
      <Color x:Key="BrandPrimaryHoverColor">#7B98FF</Color>
      <Color x:Key="BrandPrimaryPressedColor">#4F6FE4</Color>
      <Color x:Key="BrandSoftColor">#23345F</Color>
      <Color x:Key="ControlHoverColor">#253448</Color>
      <Color x:Key="ControlPressedColor">#2D3C51</Color>
      <Color x:Key="OnBrandColor">#FFFFFF</Color>
      <Color x:Key="StateRunColor">#43D19C</Color>
      <Color x:Key="StateRunSoftColor">#153B31</Color>
      <Color x:Key="StateStartingColor">#F4B94F</Color>
      <Color x:Key="StateStartingSoftColor">#4A3514</Color>
      <Color x:Key="StateStopColor">#93A1B3</Color>
      <Color x:Key="StateStopSoftColor">#263244</Color>
      <Color x:Key="DangerColor">#FF8278</Color>
      <Color x:Key="DangerSoftColor">#4A2426</Color>
      <Color x:Key="ConsoleTextColor">#D9E6F5</Color>
      <Color x:Key="ConsoleMutedColor">#8CA3BD</Color>
      <Color x:Key="ConsoleControlColor">#1F334C</Color>
      <Color x:Key="ConsoleControlHoverColor">#294564</Color>
      <Color x:Key="ConsoleControlPressedColor">#355673</Color>
    </ResourceDictionary>
