<?xml version="1.0" encoding="utf-8"?>
<!-- Main shell: top bar with four page buttons, page host, shared runtime console and status footer. -->
<Window
    x:Class="DshController.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshController"
    xmlns:views="using:DshController.Views"
    xmlns:vm="using:DshController.ViewModels"
    mc:Ignorable="d"
    Title="DSH Harness 控制器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== app title bar ==================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="54" Padding="22,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource BrandSoftBrush}">
                    <Image x:Name="TitleBarLogo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Source>
                            <SvgImageSource x:Name="TitleBarLogoSource" UriSource="ms-appx:///Assets/whale.svg"
                                            RasterizePixelWidth="40" RasterizePixelHeight="40" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="DSH HARNESS" Style="{StaticResource Wordmark}" />
                    <TextBlock Text="运行时控制台" Style="{StaticResource FooterText}" />
                </StackPanel>
            </StackPanel>

            <!-- 顶栏四页（改版·顶栏页按钮组）：选中态由 MainWindow.PageHost 换 Style -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPageInst" Style="{StaticResource BtnPage}" Content="实例" Click="BtnPageInst_Click"
                        ToolTipService.ToolTip="管理本机与 WSL 的全部 harness 实例" />
                <Button x:Name="BtnPagePlug" Style="{StaticResource BtnPage}" Content="插件" Click="BtnPagePlug_Click"
                        ToolTipService.ToolTip="插件市场与按实例的已装插件管理" />
                <Button x:Name="BtnPageArch" Style="{StaticResource BtnPage}" Content="档案" Click="BtnPageArch_Click"
                        ToolTipService.ToolTip="各实例档案与用量（含已删除实例）" />
                <Button x:Name="BtnPageApi" Style="{StaticResource BtnPage}" Content="API" Click="BtnPageApi_Click"
                        ToolTipService.ToolTip="模型供应商预设与同步" />
            </StackPanel>

            <!-- 右侧工具区（过渡位，样式在「工具区与日志底栏」小类统一精修） -->
            <StackPanel x:Name="TitleTools" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,150,0">
                <Button x:Name="BtnSettingsPage" Style="{StaticResource BtnTool}" Click="BtnSettings_Click"
                        ToolTipService.ToolTip="应用设置：路径与目录、插件与来源、数据刷新">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDevDesk" Style="{StaticResource BtnTool}" Visibility="Collapsed"
                        Click="BtnGallery_Click" ToolTipService.ToolTip="开发态：设计令牌与控件状态单页（--dev 启动可见）">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80A;" FontSize="14" />
                        <TextBlock Text="设计台" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTheme" Style="{StaticResource BtnIcon}" Click="BtnTheme_Click"
                        ToolTipService.ToolTip="切换主题：跟随系统 / 浅色 / 深色">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="14" />
                        <TextBlock Text="主题" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== page host（顶栏四页宿主；旧导航六页全部接进） ==================== -->
        <Grid x:Name="ContentRoot" Grid.Row="1" Background="{ThemeResource BgBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                    <!-- 两栏页面壳：四页统一 SplitPageShell（左上下文栏+主内容区）；控件常驻不销毁 -->
                    <views:SplitPageShell x:Name="ShellInst" Grid.Row="0" LeftEyebrow="实例">
                        <views:SplitPageShell.LeftContent>
                            <!-- 改版·详情操作主区：环境行入口退役，左栏只剩实例列表；
                                 行选中→主区呈现该实例（Windows/WSL 差异内部消化） -->
                            <views:InstancesRailView x:Name="RailWin" />
                        </views:SplitPageShell.LeftContent>
                        <views:SplitPageShell.BodyContent>
                            <Grid>
                                <local:InstancePanel x:Name="PanelWin" />
                                <local:InstancePanel x:Name="PanelWsl" Visibility="Collapsed" />
                            </Grid>
                        </views:SplitPageShell.BodyContent>
                    </views:SplitPageShell>

                    <views:SplitPageShell x:Name="ShellPlug" Grid.Row="0" LeftEyebrow="插件" Visibility="Collapsed">
                        <views:SplitPageShell.LeftContent>
                            <StackPanel Spacing="4">
                                <!-- 两项一级栏（改版·插件页左栏）：一点即换页，选中态成对样式；图标沿用旧导航字形 -->
                                <Button x:Name="BtnSubMarket" Style="{StaticResource BtnRail}"
                                        Click="BtnSubMarket_Click" ToolTipService.ToolTip="搜索社区插件并安装到指定实例">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE719;" FontSize="13" />
                                        <TextBlock Text="插件市场" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSubManage" Style="{StaticResource BtnRail}"
                                        Click="BtnSubManage_Click" ToolTipService.ToolTip="查看、升级或卸载实例插件">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" FontSize="13" />
                                        <TextBlock Text="插件管理" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </views:SplitPageShell.LeftContent>
                        <views:SplitPageShell.BodyContent>
                            <Grid>
                                <local:PluginMarketPanel x:Name="PanelMarket" />
                                <local:PluginManagePanel x:Name="PanelPlugins" Visibility="Collapsed" />
                            </Grid>
                        </views:SplitPageShell.BodyContent>
                    </views:SplitPageShell>

                    <views:SplitPageShell x:Name="ShellArch" Grid.Row="0" LeftEyebrow="档案" Visibility="Collapsed">
                        <views:SplitPageShell.LeftContent>
                            <!-- 改版·含退役列表：总计置顶+活跃+退役（置灰+徽标+退役日期 tooltip）；数据只读档案 AllUsage -->
                            <views:ArchivesRailView x:Name="RailArch" />
                        </views:SplitPageShell.LeftContent>
                        <views:SplitPageShell.BodyContent>
                            <!-- 2026-09-06 二次改版：档案页主区两页互斥（同格叠放）——
                                 左栏选中真实档案 → 单实例详情（元信息 + 完整用量）；
                                 左栏总计/无选中 → 用量看板（全部实例合并口径）。 -->
                            <Grid>
                                <views:UsageView x:Name="PanelUsage" />
                                <views:ArchiveMetaView x:Name="PanelArchiveMeta" Visibility="Collapsed" />
                            </Grid>
                        </views:SplitPageShell.BodyContent>
                    </views:SplitPageShell>

                    <views:SplitPageShell x:Name="ShellApi" Grid.Row="0" LeftEyebrow="API" Visibility="Collapsed">
                        <views:SplitPageShell.LeftContent>
                            <!-- 改版·照 dsh 模型页适配：左栏提供方列表（点选在右侧详情区配置） -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="ApiCaption" AutomationProperties.AutomationId="ApiCaption"
                                           Text="供应商 0 家" Style="{StaticResource NavCaption}" Margin="4,2,4,0" />
                                <views:ProviderRailView x:Name="RailApi" />
                            </StackPanel>
                        </views:SplitPageShell.LeftContent>
                        <views:SplitPageShell.BodyContent>
                            <!-- 改版·照 dsh 模型页适配：详情区（密钥/协议/地址/模型目录），同步写实例属预览确认 -->
                            <views:ProviderPresetsView x:Name="PanelApiPresets" />
                        </views:SplitPageShell.BodyContent>
                    </views:SplitPageShell>

                    <views:GalleryView x:Name="PanelGallery" Grid.Row="0" Visibility="Collapsed" />

                    <!-- ==================== global settings ==================== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="34,28,34,30" Spacing="18">
                            <StackPanel Spacing="5">
                                <TextBlock Text="应用设置" Style="{StaticResource PageTitle}"
                                           ToolTipService.ToolTip="报告目录与 dshCommand 修改后立即生效；其余设置会在下次新建、克隆实例或启动后端时生效。" />
                            </StackPanel>

                            <!-- 分节卡片：每行=「标题+说明+编辑器」行形（SettingHint 令牌）；控件名与读写逻辑不变 -->
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="路径与目录" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="错误报告目录" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="启动失败时生成 Markdown 报告的目录" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtReportDir" Style="{StaticResource InputBox}" VerticalAlignment="Center"
                                                 PlaceholderText="留空 = 我的文档\DshController\error-reports" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseRd" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseRd_Click" />
                                        <Button Grid.Column="3" x:Name="BtnOpenRd" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenReportDir_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="实例目录根" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="新建/克隆 Windows 实例时 DSH_HOME 的父目录" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtHomeRoot" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseRoot" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseRoot_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Windows 默认工作区" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="新建 Windows 实例的默认工作目录" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtNewWsWin" Style="{StaticResource InputBox}" VerticalAlignment="Center"
                                                 PlaceholderText="留空 = 继承当前选中实例的工作目录" />
                                        <Button Grid.Column="2" x:Name="BtnBrowseNewWsWin" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseNewWs_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="WSL 默认工作区" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="新建 WSL 实例的默认工作目录（Linux 路径）" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtNewWsWsl" Style="{StaticResource InputBox}" VerticalAlignment="Center"
                                                 PlaceholderText="留空 = ~/dsh-workspaces 或继承当前选中实例" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="插件与来源" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="目录刷新间隔" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="插件市场目录自动刷新的间隔" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtCatalogRefresh" Style="{StaticResource InputBox}" Text="24" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="小时（0 = 每次打开都刷新）" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="dshCommand" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Windows 环境 dsh 命令覆盖；留空自动查找" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtDshCommand" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="自定义市场源" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="插件市场使用的私有 registry 地址" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="TxtRegistry" Style="{StaticResource InputBox}" VerticalAlignment="Center"
                                                 PlaceholderText="留空 = 不使用自定义源" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DshCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="数据刷新" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="自动刷新实例档案" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="关闭 = 只在手动刷新或相关操作后更新" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" x:Name="SwAutoRefresh" Header="" OnContent="开启" OffContent="关闭" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="harness 版本" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="实测版本重探；启动实例或改版本后立即失效重采" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRefHarness" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="小时" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="已装插件" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="扫描实例 HOME；装卸升级后立即失效重采" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtRefPlugins" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="小时" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="token 用量（运行中）" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="运行时统计节奏；停止后自动降频" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtRefUsageRun" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="分钟" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="HOME 状态与体积" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="是否初始化、profile 列表与占用空间" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtRefHome" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="小时" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="WSL 发行版环境" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="发行版安装/运行、Linux HOME、dsh 可用性" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtRefWslEnv" Style="{StaticResource InputBox}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="小时" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="TxtArchiveInfo" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button x:Name="BtnCancelGlobal" Style="{StaticResource BtnSecondary}" Click="BtnCancelGlobal_Click" Content="取消" />
                                <Button x:Name="BtnSaveGlobal" Style="{StaticResource BtnPrimary}" Click="BtnSaveGlobal_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock Text="保存设置" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== shared runtime console ==================== -->
                    <Grid x:Name="ConsoleDock" Grid.Row="1" Background="{ThemeResource BgBaseBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DshConsoleHeader}" Margin="18,0,18,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Width="7" Height="7" CornerRadius="4" Background="{ThemeResource StateRunBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource ConsoleTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="实时" FontSize="11" Foreground="{ThemeResource ConsoleMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                    <Button x:Name="BtnAutoScroll" Style="{StaticResource BtnConsole}" Content="滚动：开" Click="BtnAutoScroll_Click" />
                                    <Button x:Name="BtnCopyLog" Style="{StaticResource BtnConsole}" Content="复制" Click="BtnCopyLog_Click" />
                                    <Button x:Name="BtnClearLog" Style="{StaticResource BtnConsole}" Content="清空" Click="BtnClearLog_Click" />
                                    <Button x:Name="BtnOpenReportDir" Style="{StaticResource BtnConsole}" Content="报告目录" Click="BtnOpenReportDir_Click" />
                                </StackPanel>
                                <Button Grid.Column="3" x:Name="BtnConsoleToggle" Style="{StaticResource BtnConsoleToggle}" Margin="8,0,0,0"
                                        Click="BtnConsoleToggle_Click" ToolTipService.ToolTip="收起或展开运行日志">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="IconConsoleToggle" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="11" />
                                        <TextBlock x:Name="TxtConsoleToggle" Text="展开" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" x:Name="ConsoleFrame" Style="{StaticResource DshConsoleFrame}" Margin="18,0,18,12">
                            <!-- 重构 2.0：日志改为虚拟化列表按行追加。
                                 原来每 100ms 把整段 20 万字符转录重新赋给 TextBox.Text，
                                 高频输出时 UI 线程每次都要重建整个字符串与文本布局。 -->
                            <ListView x:Name="LogList" Visibility="Collapsed" Height="168"
                                      SelectionMode="None" IsItemClickEnabled="False"
                                      Background="{ThemeResource BgCodeBrush}" BorderThickness="0"
                                      Padding="10,6" ScrollViewer.HorizontalScrollMode="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11.5" TextWrapping="NoWrap"
                                                   Foreground="{ThemeResource ConsoleTextBrush}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </Grid>

        <!-- ==================== status footer ==================== -->
        <Border Grid.Row="2" Background="{ThemeResource ShellBrush}"
                BorderBrush="{ThemeResource BorderBrushToken}" BorderThickness="0,1,0,0"
                Padding="22,9,22,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText" Style="{StaticResource FooterText}" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Text="DSH Controller" Style="{StaticResource FooterText}" Opacity="0.72" />
            </Grid>
        </Border>
    </Grid>
</Window>
