<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     SplitPageShell — 可复用「左边栏 + 主内容区」两栏页面壳（改版·两栏页面壳）
     · 左栏固定宽 250（单源，本文件唯一声明处）；卡片用 DshSidebarCard 令牌；
     · 左栏内容经 LeftContent 注入（列表/树均可，随 RailScroll 滚动）；
     · 主内容区经 BodyContent 注入；两槽均为纯展示容器，零取数零逻辑。
     四页（实例/插件/档案/API）共用本壳，宽度/分隔/留白天然一致。
     ============================================================================ -->
<UserControl
    x:Class="DshController.Views.SplitPageShell"
    x:Name="ShellRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左边栏：上下文列表/树容器（固定宽，不随窗口档挤压主区） -->
        <Border Grid.Column="0" Style="{StaticResource DshSidebarCard}" Margin="18,14,8,14" CornerRadius="18"
                BorderBrush="{ThemeResource BorderBrushToken}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding LeftEyebrow, ElementName=ShellRoot}"
                           Style="{StaticResource PageEyebrow}" Margin="8,8,8,10" />
                <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="RailScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding LeftContent, ElementName=ShellRoot}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 主内容区：页面宿主（各面板自带内边距，壳不再叠 padding） -->
        <ContentControl Grid.Column="1" Content="{Binding BodyContent, ElementName=ShellRoot}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
