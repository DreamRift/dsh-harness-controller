<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     ProviderPresetsView — API 页详情区（照 dsh 官方模型设置页逻辑适配）
     未选中=空态引导；选中=编辑卡（API 密钥主字段 + 自定义设置 + 模型目录 + 页脚）；
     新建=dsh 自定义提供方卡（Provider ID/协议/地址/密钥/模型目录全必填校验）。
     字段与文案逐项对齐 dsh-client-ui-settings-models；弹窗在 App 层 DialogService。
     ============================================================================ -->
<UserControl
    x:Class="DshController.Views.ProviderPresetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DshController.Views"
    xmlns:vm="using:DshController.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="34,28,34,20" Spacing="8">
            <TextBlock Text="API PROVIDERS" Style="{StaticResource PageEyebrow}" />
            <TextBlock Text="供应商预设" Style="{StaticResource HeadingLg}" AutomationProperties.AutomationId="PresetsHost" />
            <TextBlock Text="填入各提供方的 API 密钥并配置模型目录；「同步到实例」按预览确认写入实例 settings.yaml。"
                       Style="{StaticResource BodyMd}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 空态：未选中任何提供方（dsh 首次姿态的等价物） -->
        <StackPanel Grid.Row="1" Spacing="16" MaxWidth="480" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="选择左侧提供方进行配置" Style="{StaticResource HeadingMd}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="填入各提供方的 API 密钥即可使用其模型。还没有提供方时，先添加一个自定义提供方。"
                       Style="{StaticResource BodyMd}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button x:Name="BtnPresetAdd" Content="＋ 添加提供方" Style="{StaticResource BtnPrimaryEnhanced}"
                    HorizontalAlignment="Center" Click="BtnPresetAdd_Click"
                    AutomationProperties.AutomationId="BtnPresetAddEmpty" Margin="0,8,0,0" />
        </StackPanel>

        <!-- 编辑卡：新建（自定义提供方卡）/ 编辑（既有预设卡）共用一套字段 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="34,8,34,32"
                      Visibility="{x:Bind ViewModel.HasEditor, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="自定义提供方" Style="{StaticResource HeadingMd}"
                               Visibility="{x:Bind ViewModel.Editor.IsNew, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="0" Text="编辑供应商预设" Style="{StaticResource HeadingMd}"
                               Visibility="{x:Bind ViewModel.Editor.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolVis}}" />
                    <Button x:Name="BtnPresetSync" Grid.Column="1" Content="同步到实例…" Style="{StaticResource BtnSecondaryEnhanced}"
                            Click="BtnPresetSync_Click" AutomationProperties.AutomationId="BtnPresetSync"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <Button x:Name="BtnPresetDelete" Grid.Column="2" Content="删除提供方" Style="{StaticResource BtnDangerEnhanced}"
                            Click="BtnPresetDelete_Click" AutomationProperties.AutomationId="BtnPresetDelete"
                            IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"
                            ToolTipService.ToolTip="内置官方提供方不可删除" />
                </Grid>

                <!-- 密钥主字段（dsh：只写不读；空=保持已存） -->
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Text="API 密钥" Style="{StaticResource FormLabel}" />
                    <TextBox x:Name="PresetApiKey" MinWidth="400" MaxWidth="600" HorizontalAlignment="Left"
                             Style="{StaticResource TextBoxEnhanced}"
                             PlaceholderText="{x:Bind ViewModel.Editor.KeyPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Editor.ApiKeyDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="PresetApiKey" />
                    <TextBlock Text="{x:Bind ViewModel.Editor.KeyMessage, Mode=OneWay}"
                               Style="{StaticResource FormError}"
                               Visibility="{x:Bind NonEmpty(ViewModel.Editor.KeyMessage), Mode=OneWay}" />
                </StackPanel>

                <!-- 自定义设置（dsh customized 折叠区，默认展开便于一次看全） -->
                <Expander Header="自定义设置" IsExpanded="True" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="20" Margin="4,12">
                        <StackPanel Style="{StaticResource FormField}"
                                    Visibility="{x:Bind ViewModel.Editor.IsNew, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Provider ID" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PresetRoute" MinWidth="400" MaxWidth="600" HorizontalAlignment="Left"
                                     Style="{StaticResource TextBoxEnhanced}"
                                     PlaceholderText="acme-gateway"
                                     Text="{x:Bind ViewModel.Editor.Route, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="PresetRoute" />
                            <TextBlock Text="以小写字母开头的标识，在请求中唯一标识该提供方，并用于派生凭据名。"
                                       Style="{StaticResource FormHint}"
                                       Visibility="{x:Bind Empty(ViewModel.Editor.RouteError), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Editor.RouteError, Mode=OneWay}"
                                       Style="{StaticResource FormError}"
                                       Visibility="{x:Bind NonEmpty(ViewModel.Editor.RouteError), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormField}"
                                    Visibility="{x:Bind ViewModel.Editor.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolVis}}">
                            <TextBlock Text="Provider ID（创建后不可改）" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{x:Bind ViewModel.Editor.Route, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource TextBoxEnhanced}"
                                     MinWidth="400" MaxWidth="600" HorizontalAlignment="Left"
                                     AutomationProperties.AutomationId="PresetRouteView" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="显示名称" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PresetName" MinWidth="400" MaxWidth="600" HorizontalAlignment="Left"
                                     Style="{StaticResource TextBoxEnhanced}"
                                     Text="{x:Bind ViewModel.Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="PresetName" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="API 协议" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="PresetKind" MinWidth="300" HorizontalAlignment="Left"
                                      ItemsSource="{x:Bind ViewModel.Editor.Protocols, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Editor.Protocol, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="PresetKind" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="API 地址" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PresetBaseUrl" MinWidth="500" MaxWidth="700" HorizontalAlignment="Left"
                                     Style="{StaticResource TextBoxEnhanced}"
                                     PlaceholderText="提供方默认"
                                     Text="{x:Bind ViewModel.Editor.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="PresetBaseUrl" />
                        </StackPanel>

                        <CheckBox x:Name="PresetEnabled" Content="启用"
                                  IsChecked="{x:Bind ViewModel.Editor.Enabled, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="PresetEnabled" />

                        <!-- 模型目录（dsh ModelListEditor：行编辑 + 获取可用模型） -->
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型目录" Style="{StaticResource FormLabel}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="PresetFetch" Grid.Column="1"
                                        Content="{x:Bind ViewModel.Editor.FetchLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.Editor.FetchEnabled, Mode=OneWay}"
                                        Style="{StaticResource BtnSecondaryEnhanced}" Click="PresetFetch_Click"
                                        AutomationProperties.AutomationId="PresetFetch" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Editor.FetchError, Mode=OneWay}"
                                       Style="{StaticResource FormError}"
                                       Visibility="{x:Bind NonEmpty(ViewModel.Editor.FetchError), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Editor.ModelsHint, Mode=OneWay}"
                                       Style="{StaticResource FormHint}"
                                       Visibility="{x:Bind NonEmpty(ViewModel.Editor.ModelsHint), Mode=OneWay}" />

                            <!-- 模型表格 -->
                            <Border Style="{StaticResource TableContainer}">
                                <StackPanel>
                                    <!-- 表头 -->
                                    <Grid ColumnSpacing="8" Padding="16,12" Background="{ThemeResource BgSubtleBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="模型 ID" Style="{StaticResource TableHeader}" />
                                        <TextBlock Grid.Column="1" Text="显示名称" Style="{StaticResource TableHeader}" />
                                        <TextBlock Grid.Column="2" Text="上下文" Style="{StaticResource TableHeader}" />
                                        <TextBlock Grid.Column="3" Text="最大输出" Style="{StaticResource TableHeader}" />
                                        <TextBlock Grid.Column="4" Text="图片" Style="{StaticResource TableHeader}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="视频" Style="{StaticResource TableHeader}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="音频" Style="{StaticResource TableHeader}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="" Style="{StaticResource TableHeader}" />
                                    </Grid>

                                    <!-- 表格行 -->
                                    <ItemsControl x:Name="ModelRows" ItemsSource="{x:Bind ViewModel.Editor.Models, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DraftModelRow">
                                                <Border Style="{StaticResource TableCell}" Padding="16,12">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" PlaceholderText="如 deepseek-chat"
                                                                 Style="{StaticResource TextBoxEnhanced}"
                                                                 Text="{x:Bind Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="PresetModel" FontSize="13" />
                                                        <TextBox Grid.Column="1" PlaceholderText="留空时使用模型 ID"
                                                                 Style="{StaticResource TextBoxEnhanced}"
                                                                 Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="PresetModelName" FontSize="13" />
                                                        <TextBox Grid.Column="2" PlaceholderText="提供方默认"
                                                                 Style="{StaticResource TextBoxEnhanced}"
                                                                 Text="{x:Bind ContextWindowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="PresetModelContext" FontSize="13" />
                                                        <TextBox Grid.Column="3" PlaceholderText="提供方默认"
                                                                 Style="{StaticResource TextBoxEnhanced}"
                                                                 Text="{x:Bind MaxTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="PresetModelMaxTokens" FontSize="13" />
                                                        <CheckBox Grid.Column="4" IsThreeState="True" MinWidth="0" HorizontalAlignment="Center"
                                                                  IsChecked="{x:Bind SupportImage, Mode=TwoWay}"
                                                                  ToolTipService.ToolTip="支持图片输入"
                                                                  AutomationProperties.AutomationId="PresetModelImage" />
                                                        <CheckBox Grid.Column="5" IsThreeState="True" MinWidth="0" HorizontalAlignment="Center"
                                                                  IsChecked="{x:Bind SupportVideo, Mode=TwoWay}"
                                                                  ToolTipService.ToolTip="支持视频输入"
                                                                  AutomationProperties.AutomationId="PresetModelVideo" />
                                                        <CheckBox Grid.Column="6" IsThreeState="True" MinWidth="0" HorizontalAlignment="Center"
                                                                  IsChecked="{x:Bind SupportAudio, Mode=TwoWay}"
                                                                  ToolTipService.ToolTip="支持音频输入"
                                                                  AutomationProperties.AutomationId="PresetModelAudio" />
                                                        <Button Grid.Column="7" Content="✕" Style="{StaticResource BtnIconEnhanced}"
                                                                Click="RemoveModelRow_Click" ToolTipService.ToolTip="删除模型"
                                                                AutomationProperties.AutomationId="PresetModelRemove" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- 页脚（dsh EditorFooter：左取消、右提交） -->
                <Grid ColumnSpacing="12" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PresetCancel" Grid.Column="0" Content="取消" Style="{StaticResource BtnSecondaryEnhanced}"
                            Click="PresetCancel_Click" AutomationProperties.AutomationId="PresetCancel" />
                    <Button x:Name="PresetSave" Grid.Column="1" HorizontalAlignment="Right" MinWidth="140"
                            Content="{x:Bind ViewModel.Editor.SaveLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.Editor.SaveReady, Mode=OneWay}"
                            Style="{StaticResource BtnPrimaryEnhanced}" Click="PresetSave_Click"
                            AutomationProperties.AutomationId="PresetSave" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.Editor.HintText, Mode=OneWay}"
                           Style="{StaticResource FormHint}"
                           Visibility="{x:Bind NonEmpty(ViewModel.Editor.HintText), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Editor.SaveError, Mode=OneWay}"
                           Style="{StaticResource FormError}"
                           Visibility="{x:Bind NonEmpty(ViewModel.Editor.SaveError), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
