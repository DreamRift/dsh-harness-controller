<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     ArchivesRailView — 档案页左边栏的「含退役列表」（改版·含退役列表）
     行=总计（伪 id totals，置顶）/活跃/退役（置灰+「已退役」徽标+退役日期 tooltip）；
     数据只经视图模型读档案 AllUsage()（含退役）。独立成 UserControl 是
     x:Bind ItemTemplate 的形状要求（InstancesRailView 同型）。
     ============================================================================ -->
<UserControl
    x:Class="DshController.Views.ArchivesRailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DshController.Views"
    xmlns:vm="using:DshController.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 与 InstancesRailView 同型：x:Bind 的 Converter 必须在模板可及的资源域（UserControl 级）声明 -->
        <views:BoolToVisibilityConverter x:Key="RailBoolToVis" />
    </UserControl.Resources>

    <ListView x:Name="RailList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
              Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
              AutomationProperties.AutomationId="ArchivesRailList"
              SelectionChanged="RailList_SelectionChanged">
        <ListView.Resources>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource BrandSoftColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandSoftColor}" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource BrandPrimaryColor}" />
        </ListView.Resources>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ArchivesRailRow">
                <Grid ColumnSpacing="8" Opacity="{x:Bind RowOpacity}"
                      ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource LabelPrimaryBrush}" />
                        <TextBlock Text="{x:Bind SubText}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource LabelTertiaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="3" Padding="4,1"
                            Background="{ThemeResource BrandSoftBrush}"
                            Visibility="{x:Bind IsRetired, Converter={StaticResource RailBoolToVis}}">
                        <TextBlock Text="{x:Bind Badge}" FontSize="9.5"
                                   Foreground="{ThemeResource LabelSecondaryBrush}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
