<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     ArchiveMetaView — 档案页主区「单实例档案详情」（元信息 + 完整用量）
     随左栏选中呈现单份档案的镜像字段（代际/runtime/退役时间…）；
     2026-09-06 二次改版：单实例完整用量并入本页（大数卡/四桶堆叠/按天钻取/
     模型排行/会话明细），取代原用量看板的"聚焦视图"；无实例/时间切换。
     数据只经视图模型读档案（AllUsage 内存快照），页面零取数。
     独立成 UserControl 是 x:Bind 的形状要求（UsageView/InstancesRailView 同型）。
     ============================================================================ -->
<UserControl
    x:Class="DshController.Views.ArchiveMetaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DshController.ViewModels"
    xmlns:local="using:DshController.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
        <local:UsageKpiAccentConverter x:Key="UsageKpiAccent" />
        <local:UsageRangeBrushConverter x:Key="UsageRangeBrush" />
    </UserControl.Resources>

    <ScrollViewer Background="{ThemeResource BgBaseBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ArchiveMetaPanel">
        <!-- 主区随右侧内容宿主拉伸；不再使用左对齐 MaxWidth，避免单实例详情右侧出现整块空白。 -->
        <StackPanel HorizontalAlignment="Stretch" Margin="34,28,18,30" Spacing="14">
            <StackPanel Spacing="5">
                <TextBlock Text="档案元信息" Style="{StaticResource PageEyebrow}" />
                <TextBlock x:Name="MetaTitle" AutomationProperties.AutomationId="MetaTitle" Text="{x:Bind ViewModel.Title}"
                           Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource PageSubtitle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource BrandSoftBrush}">
                        <TextBlock x:Name="MetaState" AutomationProperties.AutomationId="MetaState" Text="{x:Bind ViewModel.StateLine}"
                                   FontSize="11.5" Foreground="{ThemeResource LabelPrimaryBrush}" />
                    </Border>
                    <Button x:Name="BtnRename" Content="改名" Style="{StaticResource BtnCompact}"
                            Click="BtnRename_Click" AutomationProperties.AutomationId="BtnRename" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource DshCard}">
                <StackPanel Spacing="10">
                    <Grid><TextBlock Text="档案概览" Style="{StaticResource CardTitle}" /><TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.StateLine}" Style="{StaticResource HelperText}" /></Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="180" MinItemHeight="62" MaximumRowsOrColumns="3" MinRowSpacing="8" MinColumnSpacing="8" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchiveMetaRow">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,9" BorderBrush="{ThemeResource BorderBrushToken}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="{x:Bind Label}" Style="{StaticResource HelperText}" /><TextBlock Text="{x:Bind Value}" FontSize="12.5" Foreground="{ThemeResource LabelPrimaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ==================== 用量区（2026-09-06 二次改版：单实例完整用量） ==================== -->
            <StackPanel Spacing="14" AutomationProperties.AutomationId="MetaUsageArea"
                        Visibility="{x:Bind ViewModel.HasArchive, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="用量统计" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.UsageRangeLabel, Mode=OneWay}" Style="{StaticResource HelperText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UsageUpdatedText, Mode=OneWay}"
                               Style="{StaticResource HelperText}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource BtnCompact}"
                            Command="{x:Bind ViewModel.RefreshUsageCommand}"
                            IsEnabled="{x:Bind ViewModel.UsageRefreshEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="MetaUsageRefresh"
                            ToolTipService.ToolTip="重新采集该实例的用量（退役档案没有实例可采）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="重采" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 空态：该档案还没有用量数据 -->
                <Border Style="{StaticResource DshCard}"
                        Visibility="{x:Bind ViewModel.HasUsage, Mode=OneWay, Converter={StaticResource InverseBoolVis}}">
                    <StackPanel Spacing="6" Padding="0,16" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.UsageEmptyText, Mode=OneWay}" Style="{StaticResource HelperText}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 有数据：大数卡 + 按天钻取 + 模型排行 + 会话明细（面板窄于看板：KPI 分两行、明细上下整宽） -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasUsage, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <Border Style="{StaticResource DshCardTight}" AutomationProperties.AutomationId="MetaUsageRange">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="日" Style="{StaticResource BtnCompact}" Background="{x:Bind ViewModel.UsageRangeKey, Mode=OneWay, Converter={StaticResource UsageRangeBrush}, ConverterParameter=day}" Command="{x:Bind ViewModel.SetUsageRangeCommand}" CommandParameter="day" />
                            <Button Content="近 7 天" Style="{StaticResource BtnCompact}" Background="{x:Bind ViewModel.UsageRangeKey, Mode=OneWay, Converter={StaticResource UsageRangeBrush}, ConverterParameter=7}" Command="{x:Bind ViewModel.SetUsageRangeCommand}" CommandParameter="7" />
                            <Button Content="周" Style="{StaticResource BtnCompact}" Background="{x:Bind ViewModel.UsageRangeKey, Mode=OneWay, Converter={StaticResource UsageRangeBrush}, ConverterParameter=week}" Command="{x:Bind ViewModel.SetUsageRangeCommand}" CommandParameter="week" />
                            <Button Content="月" Style="{StaticResource BtnCompact}" Background="{x:Bind ViewModel.UsageRangeKey, Mode=OneWay, Converter={StaticResource UsageRangeBrush}, ConverterParameter=month}" Command="{x:Bind ViewModel.SetUsageRangeCommand}" CommandParameter="month" />
                            <Button Content="自定义" Style="{StaticResource BtnCompact}" Background="{x:Bind ViewModel.UsageRangeKey, Mode=OneWay, Converter={StaticResource UsageRangeBrush}, ConverterParameter=custom}" Command="{x:Bind ViewModel.SetUsageRangeCommand}" CommandParameter="custom" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.UsageRangeStart, Mode=TwoWay}" Width="146" />
                            <TextBlock Text="—" VerticalAlignment="Center" Style="{StaticResource HelperText}" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.UsageRangeEnd, Mode=TwoWay}" Width="146" />
                            <Button Content="应用" Style="{StaticResource BtnCompact}" Command="{x:Bind ViewModel.ApplyCustomUsageRangeCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.UsageRangeError, Mode=OneWay}" Foreground="{ThemeResource DangerBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MetaUsageKpis">
                        <!-- 固定五列：桌面端“平均首 Token”始终紧随“估算价值”。 -->
                        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="0" MinItemHeight="126" MaximumRowsOrColumns="5" MinRowSpacing="10" MinColumnSpacing="10" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsageKpiRow">
                                <Border Style="{StaticResource DshCardTight}" BorderBrush="{x:Bind Kind, Converter={StaticResource UsageKpiAccent}}">
                                    <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="12" /></TransitionCollection></Border.Transitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource HelperText}" />
                                        <TextBlock Text="{x:Bind Value}" FontSize="28" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{x:Bind Kind, Converter={StaticResource UsageKpiAccent}}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HelperText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border Style="{StaticResource DshCard}" AutomationProperties.AutomationId="MetaUsageTrend">
                        <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="12" /></TransitionCollection></Border.Transitions>
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="用量统计" Style="{StaticResource CardTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.TrendTotalText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Content="总 Token 数" Style="{StaticResource BtnCompact}" Command="{x:Bind ViewModel.SetTrendMetricCommand}" CommandParameter="tokens" />
                                    <Button Content="总请求数" Style="{StaticResource BtnCompact}" Command="{x:Bind ViewModel.SetTrendMetricCommand}" CommandParameter="requests" />
                                    <Button Content="估算价值" Style="{StaticResource BtnCompact}" IsEnabled="False" ToolTipService.ToolTip="等待价格表接入" />
                                </StackPanel>
                            </Grid>
                            <local:UsageTrendChart Points="{x:Bind ViewModel.TrendPoints, Mode=OneWay}" Metric="{x:Bind ViewModel.TrendMetric, Mode=OneWay}" />
                            <Button Content="清除日期筛选" Style="{StaticResource BtnCompact}" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ClearUsageDayCommand}" Visibility="{x:Bind ViewModel.HasDay, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Visibility="{x:Bind ViewModel.HasDay, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.DayStripText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource LabelPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.DayModelsText, Mode=OneWay}" Style="{StaticResource HelperText}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Expander Header="查看趋势数据表">
                                <ListView ItemsSource="{x:Bind ViewModel.TrendPoints, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="vm:UsageTrendPoint"><Grid ColumnSpacing="16" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" /><TextBlock Grid.Column="1" Text="{x:Bind TokensText}" /><TextBlock Grid.Column="2" Text="{x:Bind RequestsText}" /><TextBlock Grid.Column="3" Text="{x:Bind TtftText}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DshCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="模型排行" Style="{StaticResource CardTitle}" />
                            <!-- W6：ItemsControl→ListView，启用虚拟化 + 列表自带滚动 -->
                            <ListView ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}" MaxHeight="300"
                                      SelectionMode="None" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageModelRow">
                                        <Grid ColumnSpacing="10" Padding="0,6" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" Foreground="{ThemeResource LabelPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Provider}" Style="{StaticResource HelperText}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Height="7" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Border Height="7" Width="{x:Bind ShareBarW}" CornerRadius="3" Background="{ThemeResource BrandPrimaryBrush}" HorizontalAlignment="Left" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind RequestsText}" VerticalAlignment="Center" Style="{StaticResource HelperText}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" VerticalAlignment="Center" Foreground="{ThemeResource LabelPrimaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind ShareText}" VerticalAlignment="Center" Style="{StaticResource HelperText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DshCard}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="会话明细" Style="{StaticResource CardTitle}" />
                                <TextBlock HorizontalAlignment="Right" Text="已钻取到所选日" Style="{StaticResource HelperText}"
                                           Visibility="{x:Bind ViewModel.HasDay, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <!-- W6：ItemsControl→ListView，启用虚拟化 + 列表自带滚动 -->
                            <ListView ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}" MaxHeight="340"
                                      SelectionMode="None" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageSessionRow">
                                        <StackPanel Padding="0,4" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LabelPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind CreatedText}" VerticalAlignment="Center" Style="{StaticResource HelperText}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind TurnsText}" VerticalAlignment="Center" Style="{StaticResource HelperText}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" VerticalAlignment="Center" Foreground="{ThemeResource LabelPrimaryBrush}" />
                                                <Button Grid.Column="4" Style="{StaticResource BtnCompact}" Content="详情"
                                                        Command="{x:Bind ExpandCommand}" />
                                            </Grid>
                                            <StackPanel Margin="12,6,0,4" Spacing="4" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{x:Bind ExactDetailText}" Style="{StaticResource HelperText}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind SessionId}" FontFamily="Consolas" FontSize="11" Opacity="0.75"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                    <Button Style="{StaticResource BtnCompact}" Content="复制 ID" Click="CopySessionId_Click" Tag="{x:Bind SessionId}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
