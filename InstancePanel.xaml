<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  InstancePanel — 单个运行环境（Windows / WSL）的实例管理面板（v0.5.0）

  Windows 实例与 WSL 实例在 MainWindow 的 TabView 中各占一个独立标签页，
  每个面板持有自己的实例列表 / 状态卡 / 操作按钮 / 实例设置，
  互不混用同一个"实例选项"。
  ============================================================================ -->
<UserControl
    x:Class="DshController.InstancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,12" Spacing="12">

                <!-- ==================== 实例选择器（仅本环境实例） ==================== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="实例" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" ToolTipService.ToolTip="选择本环境中要管理的实例" />
                    <ComboBox Grid.Column="1" x:Name="CmbInstance" MinHeight="32"
                              SelectionChanged="CmbInstance_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" x:Name="TxtInstanceHint" Style="{StaticResource FooterText}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </Grid>

                <!-- ==================== 状态卡片 ==================== -->
                <Border Style="{StaticResource DshCard}" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5"
                                        VerticalAlignment="Center" Background="{ThemeResource StateStopBrush}" />
                                <TextBlock x:Name="StatusText" Text="● 已停止" FontWeight="SemiBold"
                                           FontSize="15" Foreground="{ThemeResource LabelPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="HomeText" Text="DSH_HOME: ~/.dsh(默认,不注入)"
                                       Style="{StaticResource FooterText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <HyperlinkButton x:Name="UrlLink" Padding="0" Margin="0"
                                                 FontSize="13" Content="http://127.0.0.1:3080/"
                                                 NavigateUri="http://127.0.0.1:3080/">
                                    <HyperlinkButton.Resources>
                                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource BrandPrimaryColor}" />
                                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource BrandPrimaryHoverColor}" />
                                    </HyperlinkButton.Resources>
                                </HyperlinkButton>
                                <Button x:Name="BtnCopyUrl" Style="{StaticResource BtnCompact}"
                                        Content="复制" Click="BtnCopyUrl_Click" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtAnnounced" Style="{StaticResource FooterText}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                            <Border x:Name="EnvBadge" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right"
                                    Background="{ThemeResource BrandPrimaryBrush}">
                                <TextBlock x:Name="EnvBadgeText" Text="WINDOWS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource OnBrandBrush}" CharacterSpacing="60" />
                            </Border>
                            <TextBlock x:Name="VersionText" Text="harness 版本未知" Style="{StaticResource FooterText}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="进程 PID" Style="{StaticResource FooterText}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="PidText" Text="—" FontWeight="SemiBold" FontSize="16"
                                       Foreground="{ThemeResource LabelPrimaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== 主操作行 ==================== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStart" Style="{StaticResource BtnPrimary}" Click="BtnStart_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BtnRestart" Style="{StaticResource BtnSecondary}" Click="BtnRestart_Click"
                            ToolTipService.ToolTip="仅重启 harness 后端，不会打开新的浏览器界面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="15" />
                            <TextBlock Text="重启" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnStop" Style="{StaticResource BtnDangerGhost}" Click="BtnStop_Click"
                            ToolTipService.ToolTip="结束 dsh web 进程树（会话数据保留在 DSH_HOME，重启可继续）">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="15" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="BtnOpen" Style="{StaticResource BtnSecondary}" Click="BtnOpen_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="15" />
                            <TextBlock Text="打开界面" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== 实例管理行 ==================== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnNew" Style="{StaticResource BtnCompact}" Click="BtnNew_Click"
                            ToolTipService.ToolTip="在本环境新建空白实例">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="新建实例" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BtnClone" Style="{StaticResource BtnCompact}" Click="BtnClone_Click"
                            ToolTipService.ToolTip="克隆本环境的现有实例或默认主目录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13" />
                            <TextBlock Text="克隆实例" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnDelete" Style="{StaticResource BtnCompact}" Click="BtnDelete_Click"
                            ToolTipService.ToolTip="停止实例并删除注册项与数据目录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="13" />
                            <TextBlock Text="删除实例" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== 实例设置（仅本环境相关字段） ==================== -->
                <Expander x:Name="ExpInstanceSettings" Header="实例设置" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" IsExpanded="False">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="实例设置" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <StackPanel Spacing="12" Margin="4,10,4,4" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主机" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="TxtHost" Style="{StaticResource InputBox}" />
                            <TextBlock Grid.Column="2" Text="端口" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="TxtPort" Style="{StaticResource InputBox}" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="工作目录" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="Windows 路径可经 /mnt/c 按需共享给 WSL 实例" />
                            <TextBox Grid.Column="1" x:Name="TxtWorkspace" Style="{StaticResource InputBox}" />
                            <Button Grid.Column="2" x:Name="BtnBrowseWs" Style="{StaticResource BtnCompact}" Content="浏览…" Click="BtnBrowseWs_Click" />
                        </Grid>

                        <!-- Windows 专属：DSH_HOME -->
                        <Grid ColumnSpacing="10" x:Name="RowWinHome">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DSH_HOME" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="留空表示不注入，使用默认 ~/.dsh" />
                            <TextBox Grid.Column="1" x:Name="TxtHome" Style="{StaticResource InputBox}"
                                     PlaceholderText="留空 = 默认 ~/.dsh（不注入）" />
                            <Button Grid.Column="2" x:Name="BtnBrowseHome" Style="{StaticResource BtnCompact}" Content="浏览…" Click="BtnBrowseHome_Click" />
                        </Grid>

                        <!-- WSL 专属：发行版 + Linux 侧 DSH_HOME -->
                        <Grid ColumnSpacing="10" x:Name="RowWslDistro">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="发行版" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="WSL2 发行版名称（wsl --list 查看）" />
                            <TextBox Grid.Column="1" x:Name="TxtWslDistro" Style="{StaticResource InputBox}"
                                     PlaceholderText="如 Ubuntu-26.04" />
                        </Grid>
                        <Grid ColumnSpacing="10" x:Name="RowWslHome">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WSL DSH_HOME" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="Linux 侧数据目录（~ 前缀展开）；留空 = 发行版内默认 ~/.dsh" />
                            <TextBox Grid.Column="1" x:Name="TxtWslHome" Style="{StaticResource InputBox}"
                                     PlaceholderText="留空 = ~/.dsh（如 ~/dsh-instances/main）" />
                        </Grid>

                        <!-- harness 版本锁定（v0.5.0） -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="harness 版本" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="默认 = 当前环境主实例版本；可输入指定版本经 npx 拉取启动" />
                            <ComboBox Grid.Column="1" x:Name="CmbVersion" MinHeight="32" IsEditable="True"
                                      PlaceholderText="默认（跟随当前环境）" />
                            <Button Grid.Column="2" x:Name="BtnDetectVersion" Style="{StaticResource BtnCompact}"
                                    Content="检测当前版本" Click="BtnDetectVersion_Click"
                                    ToolTipService.ToolTip="重新探测当前环境 harness 主实例版本" />
                            <TextBlock Grid.Column="3" x:Name="TxtVersionHint" Style="{StaticResource FooterText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="锁定示例: 0.1.0-rc.7" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="trusted-hosts" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}"
                                       ToolTipService.ToolTip="逗号分隔，对应 dsh web --trusted-host 参数" />
                            <TextBox Grid.Column="1" x:Name="TxtTrustedHosts" Style="{StaticResource InputBox}"
                                     PlaceholderText="例：192.168.1.10, localhost" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="行为" Style="{StaticResource FieldLabel}" Width="{StaticResource SettingsLabelWidth}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="SwAutoOpen" Header="启动就绪后自动打开浏览器界面" OnContent="" OffContent="" />
                                <ToggleSwitch x:Name="SwStopOnExit" Header="退出时停止由本程序启动的后端" OnContent="" OffContent="" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnCancelInstance" Style="{StaticResource BtnSecondary}" Click="BtnCancelInstance_Click"
                                    ToolTipService.ToolTip="放弃更改并收起">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8bb;" FontSize="12" />
                                    <TextBlock Text="取消" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" x:Name="BtnSaveInstance" Style="{StaticResource BtnPrimary}" Click="BtnSaveInstance_Click"
                                    ToolTipService.ToolTip="保存当前实例设置并收起">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73e;" FontSize="12" />
                                    <TextBlock Text="保存" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ==================== 空状态提示 ==================== -->
                <Border x:Name="EmptyHint" Style="{StaticResource DshCard}" Visibility="Collapsed">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14"
                                      Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmptyHintText" Text="本环境暂无实例，点击「新建实例」开始"
                                       Style="{StaticResource FooterText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="BtnNewFromEmpty" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center"
                                Click="BtnNew_Click" MinWidth="140">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="新建实例" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
