<?xml version="1.0" encoding="utf-8"?>
<!-- Instance workspace. The order follows the task flow: choose → inspect → act → configure. -->
<UserControl
    x:Class="DshController.InstancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="34,28,34,30" Spacing="18">

                <!-- ==================== page heading ==================== -->
                <StackPanel Spacing="5">
                    <TextBlock x:Name="TxtPageEyebrow" Text="RUNTIME WORKSPACE" Style="{StaticResource PageEyebrow}" />
                    <TextBlock x:Name="TxtPageTitle" Text="Windows 实例" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="TxtPageSubtitle" Text="选择一个实例，查看运行状态并管理它的 harness 后端。"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <!-- ==================== instance toolbar ==================== -->
                <Border Style="{StaticResource DshToolbarCard}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前实例" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="CmbInstance" Style="{StaticResource InputCombo}" HorizontalAlignment="Stretch"
                                  SelectionChanged="CmbInstance_SelectionChanged"
                                  ToolTipService.ToolTip="选择要管理的实例（名称 · 端口 · 指定版本）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PickerLabel}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" x:Name="BtnNew" Style="{StaticResource BtnCompact}" Click="BtnNew_Click"
                                ToolTipService.ToolTip="在本环境新建实例">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="新建" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="BtnClone" Style="{StaticResource BtnCompact}" Click="BtnClone_Click"
                                ToolTipService.ToolTip="克隆本环境的现有实例或默认主目录">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="12" />
                                <TextBlock Text="克隆" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" x:Name="BtnDelete" Style="{StaticResource BtnCompact}" Click="BtnDelete_Click"
                                ToolTipService.ToolTip="停止该实例并删除注册项与数据目录">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="删除" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" x:Name="BtnScan" Style="{StaticResource BtnCompact}" Click="BtnScan_Click"
                                ToolTipService.ToolTip="扫描本环境中正在运行但未注册的 harness 实例">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock x:Name="TxtScanLabel" Text="扫描" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock x:Name="TxtInstanceHint" Style="{StaticResource HelperText}" Margin="2,-10,2,0" />

                <!-- ==================== failure recovery ==================== -->
                <InfoBar x:Name="FailBar" IsOpen="False" Severity="Error" IsClosable="True"
                         Title="后端启动失败" Message="">
                    <InfoBar.ActionButton>
                        <Button x:Name="BtnOpenReport" Content="打开报告" Click="BtnOpenReport_Click" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,10">
                            <Button x:Name="BtnOpenReportDir" Style="{StaticResource BtnCompact}" Content="打开报告目录" Click="BtnOpenReportDir_Click" />
                            <Button x:Name="BtnCopyReportPath" Style="{StaticResource BtnCompact}" Content="复制报告路径" Click="BtnCopyReportPath_Click" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- ==================== status hero ==================== -->
                <Border Style="{StaticResource DshHeroCard}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5"
                                        VerticalAlignment="Center" Background="{ThemeResource StateStopBrush}" />
                                <TextBlock x:Name="StatusText" Text="已停止" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource LabelPrimaryBrush}" VerticalAlignment="Center" />
                                <Border x:Name="EnvBadge" CornerRadius="8" Padding="9,4" VerticalAlignment="Center"
                                        Background="{ThemeResource BrandSoftBrush}">
                                    <TextBlock x:Name="EnvBadgeText" Text="WINDOWS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource BrandPrimaryBrush}" CharacterSpacing="70" />
                                </Border>
                                <Border Style="{StaticResource Chip}" ToolTipService.ToolTip="本实例生效的 harness 版本">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource ChipText}" Text="harness 版本未知" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="13"
                                          Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="UrlLink" Padding="0" Margin="0" FontSize="14"
                                                 Content="http://127.0.0.1:3080/" NavigateUri="http://127.0.0.1:3080/"
                                                 ToolTipService.ToolTip="在浏览器中打开该实例界面">
                                    <HyperlinkButton.Resources>
                                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource BrandPrimaryColor}" />
                                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource BrandPrimaryHoverColor}" />
                                    </HyperlinkButton.Resources>
                                </HyperlinkButton>
                                <Button x:Name="BtnCopyUrl" Style="{StaticResource BtnCompact}" Content="复制地址"
                                        Click="BtnCopyUrl_Click" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtAnnounced" Style="{StaticResource HelperText}" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock x:Name="HomeText" Text="DSH_HOME: ~/.dsh（默认，不注入）" Style="{StaticResource HelperText}" />
                                <TextBlock x:Name="LaunchModeText" Style="{StaticResource HelperText}" Text="启动方式：当前环境已安装的 dsh" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="进程 PID" Style="{StaticResource FooterText}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="PidText" Text="—" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="22"
                                       Foreground="{ThemeResource LabelPrimaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== primary actions ==================== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStart" Style="{StaticResource BtnPrimary}" Click="BtnStart_Click"
                            ToolTipService.ToolTip="启动该实例后端">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="启动后端" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BtnRestart" Style="{StaticResource BtnSecondary}" Click="BtnRestart_Click"
                            ToolTipService.ToolTip="仅重启 harness 后端，不会打开新的浏览器界面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="15" />
                            <TextBlock Text="重启" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnStop" Style="{StaticResource BtnDangerGhost}" Click="BtnStop_Click"
                            ToolTipService.ToolTip="结束 dsh web 进程树">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="15" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="BtnOpen" Style="{StaticResource BtnSecondary}" Click="BtnOpen_Click"
                            ToolTipService.ToolTip="在默认浏览器打开该实例界面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="15" />
                            <TextBlock Text="打开界面" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== configuration ==================== -->
                <Expander x:Name="ExpInstanceSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="实例设置" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtSettingsSubtitle" Style="{StaticResource FooterText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>

                    <Border Style="{StaticResource DshCard}" Margin="0,12,0,0" Padding="20,18">
                        <StackPanel Spacing="13">
                            <TextBlock Text="网络" Style="{StaticResource SectionHeader}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主机" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TxtHost" Style="{StaticResource InputBox}" />
                                <TextBlock Grid.Column="2" Text="端口" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                                <TextBox Grid.Column="3" x:Name="TxtPort" Style="{StaticResource InputBox}" />
                                <Button Grid.Column="4" x:Name="BtnSuggestPort" Style="{StaticResource BtnCompact}" Content="推荐空闲端口"
                                        Click="BtnSuggestPort_Click" />
                            </Grid>

                            <TextBlock Text="路径" Style="{StaticResource SectionHeader}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="工作目录" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TxtWorkspace" Style="{StaticResource InputBox}" />
                                <Button Grid.Column="2" x:Name="BtnBrowseWs" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseWs_Click" />
                                <Button Grid.Column="3" x:Name="BtnOpenWs" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenWs_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtWorkspaceHint" Style="{StaticResource HelperText}" Margin="122,-8,0,0" />

                            <Grid ColumnSpacing="10" x:Name="RowWinHome">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DSH_HOME" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TxtHome" Style="{StaticResource InputBox}" PlaceholderText="留空 = 默认 ~/.dsh（不注入）" />
                                <Button Grid.Column="2" x:Name="BtnBrowseHome" Style="{StaticResource BtnCompact}" Content="浏览" Click="BtnBrowseHome_Click" />
                                <Button Grid.Column="3" x:Name="BtnOpenHome" Style="{StaticResource BtnCompact}" Content="打开" Click="BtnOpenHome_Click" />
                            </Grid>

                            <Grid ColumnSpacing="10" x:Name="RowWslDistro">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="发行版" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" x:Name="CmbWslDistro" Style="{StaticResource InputCombo}" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="如 Ubuntu-24.04" />
                                <Button Grid.Column="2" x:Name="BtnListDistros" Style="{StaticResource BtnCompact}" Content="扫描发行版" Click="BtnListDistros_Click" />
                            </Grid>

                            <Grid ColumnSpacing="10" x:Name="RowWslHome">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WSL DSH_HOME" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TxtWslHome" Style="{StaticResource InputBox}" PlaceholderText="留空 = ~/.dsh（如 ~/dsh-instances/main）" />
                            </Grid>

                            <TextBlock Text="HARNESS 版本" Style="{StaticResource SectionHeader}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" x:Name="CmbVersion" Style="{StaticResource InputCombo}" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="跟随当前环境（默认）" />
                                <Button Grid.Column="2" x:Name="BtnDetectVersion" Style="{StaticResource BtnCompact}" Content="检测当前版本" Click="BtnDetectVersion_Click" />
                                <Button Grid.Column="3" x:Name="BtnFetchVersions" Style="{StaticResource BtnCompact}" Content="拉取版本列表" Click="BtnFetchVersions_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtVersionHint" Style="{StaticResource HelperText}" Margin="122,-8,0,0"
                                       Text="跟随当前环境会直接使用已安装的 dsh；指定版本会通过 npx 拉取。" />

                            <TextBlock Text="高级" Style="{StaticResource SectionHeader}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="trusted-hosts" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TxtTrustedHosts" Style="{StaticResource InputBox}" PlaceholderText="例：192.168.1.10, localhost" />
                            </Grid>

                            <Grid ColumnSpacing="10" x:Name="RowWslPolicy">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="停止后关闭" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" x:Name="CmbWslPolicy" Style="{StaticResource InputCombo}" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="2" Style="{StaticResource HelperText}" VerticalAlignment="Center"
                                           Text="smart = 无其他实例时再关闭发行版或 VM" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SettingsLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="行为" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <ToggleSwitch x:Name="SwAutoOpen" Header="启动就绪后自动打开浏览器界面" OnContent="" OffContent="" />
                                    <ToggleSwitch x:Name="SwStopOnExit" Header="退出程序时停止由本程序启动的后端" OnContent="" OffContent="" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="BtnCancelInstance" Style="{StaticResource BtnSecondary}" Click="BtnCancelInstance_Click" Content="取消" />
                                <Button x:Name="BtnSaveInstance" Style="{StaticResource BtnPrimary}" Click="BtnSaveInstance_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock Text="保存实例" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- ==================== empty state ==================== -->
                <Border x:Name="EmptyHint" Style="{StaticResource DshInfoCard}" Visibility="Collapsed">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmptyHintText" Text="本环境暂无实例，点击「新建」开始"
                                       Style="{StaticResource HelperText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="BtnNewFromEmpty" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center"
                                Click="BtnNew_Click" MinWidth="140">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="新建实例" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
