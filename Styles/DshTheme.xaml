<!-- ============================================================================
  DshTheme.xaml — DeepSeek Harness 设计令牌 → WinUI 3 资源

  令牌真值提取自 dsh-web-frontend 真实 CSS（见 docs/RESEARCH-NOTES.md §4）：
    品牌蓝 #3964FE  页面底 #F9FAFB / #151517  主文字 #0F1115
    次级 #61666B  三级 #81858C  边框 10% 前景色
  Light/Dark 两套 ThemeDictionary，随系统或用户覆盖自动切换。
============================================================================ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

  <ResourceDictionary.ThemeDictionaries>

    <!-- ======================= Light（默认，对应 DSH web 浅色） ======================= -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgBaseColor">#F9FAFB</Color>
      <Color x:Key="BgCardColor">#FFFFFF</Color>
      <Color x:Key="BgCodeColor">#FAFBFC</Color>
      <Color x:Key="LabelPrimaryColor">#0F1115</Color>
      <Color x:Key="LabelSecondaryColor">#61666B</Color>
      <Color x:Key="LabelTertiaryColor">#81858C</Color>
      <Color x:Key="BorderColor">#170F1115</Color>          <!-- 10% 前景 ≈ #17000000 微偏蓝黑 -->
      <Color x:Key="BrandPrimaryColor">#3964FE</Color>
      <Color x:Key="BrandPrimaryHoverColor">#4D74FF</Color>
      <Color x:Key="BrandPrimaryPressedColor">#2C50DD</Color>
      <Color x:Key="OnBrandColor">#FFFFFF</Color>
      <Color x:Key="StateRunColor">#2FA57E</Color>
      <Color x:Key="StateStartingColor">#E8A33D</Color>
      <Color x:Key="StateStopColor">#81858C</Color>
      <Color x:Key="DangerColor">#D94840</Color>
      <Color x:Key="OverlayHoverColor">#0F0F1115</Color>    <!-- 6% -->
    </ResourceDictionary>

    <!-- ======================= Dark（对应 DSH web 深色） ======================= -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgBaseColor">#151517</Color>
      <Color x:Key="BgCardColor">#1E1E22</Color>
      <Color x:Key="BgCodeColor">#131315</Color>
      <Color x:Key="LabelPrimaryColor">#F0F1F3</Color>
      <Color x:Key="LabelSecondaryColor">#9BA0A8</Color>
      <Color x:Key="LabelTertiaryColor">#6F737A</Color>
      <Color x:Key="BorderColor">#1AFFFFFF</Color>          <!-- 10% 白 -->
      <Color x:Key="BrandPrimaryColor">#3964FE</Color>
      <Color x:Key="BrandPrimaryHoverColor">#5579FF</Color>
      <Color x:Key="BrandPrimaryPressedColor">#2C50DD</Color>
      <Color x:Key="OnBrandColor">#FFFFFF</Color>
      <Color x:Key="StateRunColor">#3CC493</Color>
      <Color x:Key="StateStartingColor">#EDB159</Color>
      <Color x:Key="StateStopColor">#6F737A</Color>
      <Color x:Key="DangerColor">#E56860</Color>
      <Color x:Key="OverlayHoverColor">#14FFFFFF</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ============ 刷子（主题令牌引用，控件与页面一律使用刷子） ============ -->
  <SolidColorBrush x:Key="BgBaseBrush" Color="{ThemeResource BgBaseColor}" />
  <SolidColorBrush x:Key="BgCardBrush" Color="{ThemeResource BgCardColor}" />
  <SolidColorBrush x:Key="BgCodeBrush" Color="{ThemeResource BgCodeColor}" />
  <SolidColorBrush x:Key="LabelPrimaryBrush" Color="{ThemeResource LabelPrimaryColor}" />
  <SolidColorBrush x:Key="LabelSecondaryBrush" Color="{ThemeResource LabelSecondaryColor}" />
  <SolidColorBrush x:Key="LabelTertiaryBrush" Color="{ThemeResource LabelTertiaryColor}" />
  <SolidColorBrush x:Key="BorderBrushToken" Color="{ThemeResource BorderColor}" />
  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource BrandPrimaryColor}" />
  <SolidColorBrush x:Key="OnBrandBrush" Color="{ThemeResource OnBrandColor}" />
  <SolidColorBrush x:Key="StateRunBrush" Color="{ThemeResource StateRunColor}" />
  <SolidColorBrush x:Key="StateStartingBrush" Color="{ThemeResource StateStartingColor}" />
  <SolidColorBrush x:Key="StateStopBrush" Color="{ThemeResource StateStopColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />

  <!-- ============ 文本样式 ============ -->
  <Style x:Key="Wordmark" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CharacterSpacing" Value="80" />  <!-- 0.08em，DSH wordmark 字距 -->
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="FooterText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource LabelTertiaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ============ 卡片 ============ -->
  <Style x:Key="DshCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- ============ 按钮 ============ -->
  <!-- 主操作：品牌蓝填充（对应 DSH web 主按钮） -->
  <Style x:Key="BtnPrimary" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnBrandBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!-- 次操作：卡片底 + 细描边幽灵按钮 -->
  <Style x:Key="BtnSecondary" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource BgCardBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LabelPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!-- 危险操作（停止）：描边幽灵 + 危险色文字，悬停填充 -->
  <Style x:Key="BtnDangerGhost" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DangerBrush}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <!-- 小型内联按钮（复制/浏览/清空） -->
  <Style x:Key="BtnCompact" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- 图标按钮（主题切换等） -->
  <Style x:Key="BtnIcon" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ============ 输入框 ============ -->
  <Style x:Key="InputBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- ============ 日志区（等宽） ============ -->
  <Style x:Key="LogBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Courier New" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{ThemeResource BgCodeBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushToken}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
  </Style>

  <!-- ============ 设置行标签列固定宽 ============ -->
  <x:Double x:Key="SettingsLabelWidth">96</x:Double>

</ResourceDictionary>
